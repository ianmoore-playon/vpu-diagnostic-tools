[Version]
Signature="$CHICAGO$"
Class=GIEController
ClassGuid={5fd426fe-8f88-40bb-85b9-0a7d1328a6ae}
Provider=%String0%
CatalogFile=Pex8614.cat
DriverVer=11/25/2022,1.2.3.0320
DriverPackageType=KernelService

[ClassInstall32]
AddReg = PoEClassAddReg

;[ClassInstall32.Services]
;AddService=Pex8614,2,DriverService,

[PoEClassAddReg]
HKR,,,,"GIESeries Controller"
HKR,,Icon,,"-10"
HKR,,NoDisplayClass,,1

;[Manufacturer]
;%String1%=ADLINK, nt$ARCH$

;[ADLINK.nt$ARCH$]
;%String2%=DriverInstall,PCI\VEN_10B5\DEV_8608

;------------------------------------------------------------------------------
;  Windows 2000 Sections
;------------------------------------------------------------------------------

[DefaultInstall.Services]
AddService=Pex8614,2,DriverService,

[DestinationDirs]
DriverCopyFiles=12

[DefaultInstall]
CopyFiles=DriverCopyFiles
;AddReg=DriverHwAddReg

[DriverCopyFiles]
Pex8614.sys

[DefaultUninstall]
DelFiles   = DriverCopyFiles

[DefaultUninstall.Services]
DelService = Pex8614,0x200      ;Ensure service is stopped before deleting

[DriverService]
ServiceType=1
StartType=2
ErrorControl=1
ServiceBinary=%12%\Pex8614.sys
LoadOrderGroup  = Extended Base

;[DriverHwAddReg]
;HKR,,FriendlyName,,"GIE Pex8614"

[SourceDisksNames]
1=%String1%,,,

[SourceDisksFiles]
Pex8614.sys=1,,

;------------------------------------------------------------------------------
;  String Definitions
;------------------------------------------------------------------------------


[Strings]
String0="ADLINK Technology Inc."
String1="ADLINK Technology Inc."
String2="ADLINK PEX8614"
