<Window x:Class="Pulse.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:Pulse.WPF.ViewModels"
        xmlns:views="clr-namespace:Pulse.WPF.Views"
        xmlns:helpers="clr-namespace:Pulse.WPF.Helpers"
        Title="Pulse — Pixellot Unified Live System Evaluator (WPF Pilot)"
        Width="1500" Height="850" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBgBrush}"
        TextElement.Foreground="{StaticResource ForegroundBrush}"
        TextElement.FontFamily="Segoe UI"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <!-- ====== Outer layout: sidebar (left) + content area (right) ====== -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />   <!-- Sidebar nav -->
            <ColumnDefinition Width="*" />     <!-- Content -->
        </Grid.ColumnDefinitions>

        <!-- ====== Sidebar ====== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}"
                KeyboardNavigation.TabNavigation="Cycle"
                KeyboardNavigation.DirectionalNavigation="Cycle"
                AutomationProperties.Name="Primary navigation">
            <DockPanel>
                <!-- Brand block -->
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,32">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Pulse" Width="28" Height="28"
                                     Foreground="{StaticResource AccentBrush}"
                                     VerticalAlignment="Center" />
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="Pulse" FontFamily="Segoe UI Semibold" FontSize="18"
                                       Foreground="{StaticResource ForegroundBrush}" />
                            <TextBlock Text="VPU Diagnostics" FontSize="10"
                                       Foreground="{StaticResource MutedForegroundBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Bottom-pinned utility buttons -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,16">
                    <!-- Version chrome — read once from the assembly via
                         Pulse.WPF.Helpers.AppVersion. Tooltip shows the full
                         version + commit SHA when InformationalVersion was
                         set at build time. -->
                    <TextBlock Text="{x:Static helpers:AppVersion.Display}"
                               ToolTip="{x:Static helpers:AppVersion.Tooltip}"
                               Foreground="{StaticResource MutedForegroundBrush}"
                               FontSize="10"
                               Margin="22,0,0,10"
                               AutomationProperties.Name="Pulse version" />
                    <ToggleButton Style="{StaticResource SidebarNavButton}" IsEnabled="False"
                                  AutomationProperties.Name="Settings">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Cog" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="Settings" Margin="14,0,0,0" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource SidebarNavButton}" IsEnabled="False"
                                  AutomationProperties.Name="About Pulse">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="InformationOutline" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="About" Margin="14,0,0,0" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>

                <!-- ====== Main nav stack ======
                     Each ToggleButton:
                       - Binds IsChecked to MainViewModel.IsX (one-way OK in WPF since
                         setter triggers via Command).
                       - Binds Command + CommandParameter to NavigateCommand("Key"). -->
                <StackPanel>
                    <ToggleButton Style="{StaticResource SidebarNavButton}"
                                  IsChecked="{Binding IsHome, Mode=OneWay}"
                                  Command="{Binding NavigateCommand}" CommandParameter="Dashboard"
                                  AutomationProperties.Name="Dashboard">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="ViewDashboardOutline" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="Dashboard" Margin="14,0,0,0" />
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton Style="{StaticResource SidebarNavButton}"
                                  IsChecked="{Binding IsSystemOverview, Mode=OneWay}"
                                  Command="{Binding NavigateCommand}" CommandParameter="SystemOverview"
                                  AutomationProperties.Name="System Overview">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="InformationOutline" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="System Overview" Margin="14,0,0,0" />
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton Style="{StaticResource SidebarNavButton}"
                                  IsChecked="{Binding IsNetwork, Mode=OneWay}"
                                  Command="{Binding NavigateCommand}" CommandParameter="Network"
                                  AutomationProperties.Name="Network Configuration">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="WifiCog" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="Network Configuration" Margin="14,0,0,0" />
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton Style="{StaticResource SidebarNavButton}"
                                  IsChecked="{Binding IsCamera, Mode=OneWay}"
                                  Command="{Binding NavigateCommand}" CommandParameter="Camera"
                                  AutomationProperties.Name="Camera Connectivity">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="CameraOutline" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="Camera Connectivity" Margin="14,0,0,0" />
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton Style="{StaticResource SidebarNavButton}"
                                  IsChecked="{Binding IsHardware, Mode=OneWay}"
                                  Command="{Binding NavigateCommand}" CommandParameter="Hardware"
                                  AutomationProperties.Name="Hardware and Peripherals">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Memory" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="Hardware &amp; Peripherals" Margin="14,0,0,0" />
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton Style="{StaticResource SidebarNavButton}"
                                  IsChecked="{Binding IsServices, Mode=OneWay}"
                                  Command="{Binding NavigateCommand}" CommandParameter="Services"
                                  AutomationProperties.Name="Pixellot Services">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="ServerNetwork" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="Pixellot Services" Margin="14,0,0,0" />
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton Style="{StaticResource SidebarNavButton}"
                                  IsChecked="{Binding IsDisk, Mode=OneWay}"
                                  Command="{Binding NavigateCommand}" CommandParameter="Disk"
                                  AutomationProperties.Name="Disk and System Health">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Harddisk" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="Disk &amp; System Health" Margin="14,0,0,0" />
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton Style="{StaticResource SidebarNavButton}"
                                  IsChecked="{Binding IsEventViewer, Mode=OneWay}"
                                  Command="{Binding NavigateCommand}" CommandParameter="EventViewer"
                                  AutomationProperties.Name="Event Viewer">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="AlertOutline" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="Event Viewer" Margin="14,0,0,0" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource SidebarNavButton}"
                                  IsChecked="{Binding IsReports, Mode=OneWay}"
                                  Command="{Binding NavigateCommand}" CommandParameter="Reports"
                                  AutomationProperties.Name="Reports">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="FileDocumentOutline" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="Reports" Margin="14,0,0,0" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ====== Content area: a single ContentControl whose Content is the
             active panel viewmodel. App.xaml owns the DataTemplate for each
             VM type, so this is the only place that knows about the panels. -->
        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentView}" />
    </Grid>
</Window>
