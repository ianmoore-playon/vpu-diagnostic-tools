<!--
    Pulse.WPF — reusable styles.
    Card  : the rounded surface used by every detail card / log card / etc.
    Chip  : pill-style label for "Linked", "Degraded", etc.
    HeadingTitle / HeadingSubtitle / SectionTitle : type scale.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============================================================ -->
    <!-- Spacing tokens — multiples of 4 per UX_REVIEW Section 2.     -->
    <!-- ============================================================ -->
    <Thickness x:Key="GapXs">4</Thickness>
    <Thickness x:Key="GapSm">8</Thickness>
    <Thickness x:Key="GapMd">12</Thickness>
    <Thickness x:Key="GapLg">16</Thickness>
    <Thickness x:Key="GapXl">24</Thickness>
    <Thickness x:Key="GapXxl">32</Thickness>

    <sys:Double x:Key="GapXsValue">4</sys:Double>
    <sys:Double x:Key="GapSmValue">8</sys:Double>
    <sys:Double x:Key="GapMdValue">12</sys:Double>
    <sys:Double x:Key="GapLgValue">16</sys:Double>
    <sys:Double x:Key="GapXlValue">24</sys:Double>
    <sys:Double x:Key="GapXxlValue">32</sys:Double>

    <!-- ============================================================ -->
    <!-- Font-size tokens (v0.5.0). Lifted from the six most-repeated  -->
    <!-- inline FontSize literals across Dashboard / System Overview / -->
    <!-- Network views — stops the drift, single place to retune.      -->
    <!-- ============================================================ -->
    <sys:Double x:Key="FontSize.Caption">10</sys:Double>
    <sys:Double x:Key="FontSize.Small">11</sys:Double>
    <sys:Double x:Key="FontSize.Body">12</sys:Double>
    <sys:Double x:Key="FontSize.Mono">13</sys:Double>
    <sys:Double x:Key="FontSize.Heading">15</sys:Double>
    <sys:Double x:Key="FontSize.Display">28</sys:Double>

    <!-- ============================================================ -->
    <!-- Spacing aliases — the same Gap values exposed under the names -->
    <!-- the v0.5.0 token pass adopted. Keep the GapMd / GapLg keys    -->
    <!-- working too so existing bindings don't break.                 -->
    <!-- ============================================================ -->
    <Thickness x:Key="Spacing.RowGap">0,4,0,0</Thickness>
    <Thickness x:Key="Spacing.RowGapSm">0,2,0,0</Thickness>
    <Thickness x:Key="Spacing.Card">0,12,0,0</Thickness>
    <Thickness x:Key="Spacing.Page">0,0,0,16</Thickness>
    <Thickness x:Key="Spacing.PageLg">0,0,0,20</Thickness>
    <Thickness x:Key="Spacing.InlineLeft">8,0,0,0</Thickness>
    <Thickness x:Key="Spacing.InlineLeftLg">10,0,0,0</Thickness>

    <!-- ============================================================ -->
    <!-- Card elevations — three levels per UX_REVIEW Section 2.      -->
    <!--   CardFlat   : grouping inside a card (no shadow)            -->
    <!--   CardElev1  : default content surfaces (== legacy "Card")   -->
    <!--   CardElev2  : Findings banner, modals                       -->
    <!-- ============================================================ -->
    <Style x:Key="CardFlat" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderColBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="CardElev1" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderColBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" BlurRadius="10" Opacity="0.10" ShadowDepth="1" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardElev2" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBgRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderColBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" BlurRadius="20" Opacity="0.32" ShadowDepth="4" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Backwards-compat: legacy "Card" key. Existing XAML is unchanged,
         but the default surface is now flatter and quieter. Use CardElev1/2
         only for intentionally raised diagnostic surfaces. -->
    <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource CardFlat}" />

    <Style x:Key="DashboardHeroSurface" TargetType="Border" BasedOn="{StaticResource CardElev2}">
        <Setter Property="Padding" Value="20" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{StaticResource CardBgRaisedBrush}" />
    </Style>

    <!-- ============================================================ -->
    <!-- Typography — 7-step scale per UX_REVIEW Section 2.           -->
    <!-- ============================================================ -->
    <Style x:Key="DisplayLg" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
    </Style>

    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
    </Style>

    <Style x:Key="BodyDefault" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
    </Style>

    <Style x:Key="BodyStrong" TargetType="TextBlock" BasedOn="{StaticResource BodyDefault}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="MetaSm" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
    </Style>

    <Style x:Key="Mono11" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
    </Style>

    <!-- Backwards-compat aliases for the prior style names -->
    <Style x:Key="MutedLabel" TargetType="TextBlock" BasedOn="{StaticResource MetaSm}" />
    <Style x:Key="MonoValue"  TargetType="TextBlock" BasedOn="{StaticResource Mono11}" />

    <!-- ====== Status pill ("All Clear" / "Issues Found" / "Running") ====== -->
    <Style x:Key="StatusChip" TargetType="Border">
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Background" Value="{StaticResource OkBgBrush}" />
    </Style>

    <!-- ====== Findings banner (reusable across every panel) ======
         The banner only renders when HasFindings == true on the panel VM.
         Each row inside is a Finding model (Severity / Title / Recommendation).
         Defined as styles here so FindingsBanner.xaml in Controls/ stays small
         and so individual panels can opt into the look without duplicating it. -->
    <Style x:Key="FindingsBannerOuter" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource YellowBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" BlurRadius="20" Opacity="0.32" ShadowDepth="3" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One finding row inside the banner -->
    <Style x:Key="FindingRow" TargetType="Border">
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderColBrush}" />
        <Setter Property="Padding" Value="0,10" />
    </Style>

    <Style x:Key="FindingSeverityChip" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="MinWidth" Value="68" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="FindingTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="FindingRecommendation" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <!-- ====== Hub tile (System Overview) ======
         Big-button card the user clicks to jump to a panel. Uses the same
         CardBg as a regular card but with a hover lift via BorderBrush. -->
    <Style x:Key="HubTile" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderColBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="12" Opacity="0.18" ShadowDepth="2" />
                        </Border.Effect>
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SubsystemHealthTile" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderColBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="bg" Property="Background" Value="{StaticResource CardBgRaisedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====== Service-status pill (Pixellot Services) ======
         Same shape as StatusChip but smaller, used inline in tables. -->
    <Style x:Key="StatusChipSm" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- ============================================================ -->
    <!-- Top-bar action button (v0.5.4).                              -->
    <!-- Used for every header-row action across panels: Refresh,    -->
    <!-- Copy as text, Open Reports Folder, etc. Outlined, 36 px tall,-->
    <!-- 12 pt label, 16 px icon, 8 px right margin between buttons. -->
    <!-- Smaller than the legacy bottom-bar 44 px raised CTAs so the  -->
    <!-- buttons sit comfortably next to the status pill without     -->
    <!-- competing with it visually.                                 -->
    <!-- ============================================================ -->
    <Style x:Key="TopBarOutlinedButton" TargetType="Button"
           BasedOn="{StaticResource MaterialDesignOutlinedButton}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Primary top-bar action — the panel's "Refresh" / "Run Test". -->
    <!-- Same shape as TopBarOutlinedButton but with an accent-coloured-->
    <!-- border + bold label so a tech reads it as the primary action -->
    <!-- without it shouting like a raised CTA.                       -->
    <Style x:Key="TopBarPrimaryButton" TargetType="Button"
           BasedOn="{StaticResource TopBarOutlinedButton}">
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ============================================================ -->
    <!-- Reusable modal dialog window style (v0.5.2 §6).               -->
    <!-- First modal in the project — keyed PulseDialogWindow so       -->
    <!-- future settings / about / etc. dialogs can re-use it.         -->
    <!-- ============================================================ -->
    <Style x:Key="PulseDialogWindow" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource AppBgBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="ResizeMode" Value="CanResize" />
        <Setter Property="MinWidth" Value="520" />
        <Setter Property="MinHeight" Value="420" />
        <Setter Property="WindowStartupLocation" Value="CenterOwner" />
        <Setter Property="ShowInTaskbar" Value="False" />
    </Style>

    <!-- ============================================================ -->
    <!-- Focus visual — visible on dark backgrounds.                   -->
    <!-- BorderColStrong 2 px outline per UX_REVIEW Section 6.        -->
    <!-- ============================================================ -->
    <Style x:Key="PulseFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2"
                               Stroke="{DynamicResource BorderColStrongBrush}"
                               StrokeThickness="2"
                               StrokeDashArray="1 0"
                               SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Apply globally to every Control so keyboard focus is always visible. -->
    <Style TargetType="{x:Type Control}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource PulseFocusVisual}" />
    </Style>

    <!-- ====== Sidebar nav button ====== -->
    <Style x:Key="SidebarGroupLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource SubtleForegroundBrush}" />
        <Setter Property="Margin" Value="20,18,20,6" />
    </Style>

    <Style x:Key="SidebarNavButton" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bg"
                            Background="{TemplateBinding Background}"
                            BorderThickness="3,0,0,0"
                            BorderBrush="Transparent">
                        <ContentPresenter HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{StaticResource SidebarHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{StaticResource CardBgBrush}" />
                            <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!-- v0.6.5 — global default DataGridColumnHeader style.            -->
    <!--                                                                -->
    <!-- Field tech on VPU2 reported column headers rendering           -->
    <!-- white-on-white (invisible) inside the Services / Disk Health   -->
    <!-- DataGrids — those views set                                    -->
    <!-- `ColumnHeaderStyle="{x:Null}"`, defeating the                  -->
    <!-- MaterialDesignThemes default which assumed a light surface.    -->
    <!--                                                                -->
    <!-- This implicit style (no x:Key) applies wherever a DataGrid     -->
    <!-- doesn't already pick its own header style (e.g. SystemOverview -->
    <!-- which has SiDataGridHeader). Headers now read as semibold      -->
    <!-- 10 pt muted text on the raised surface, matching the panel-    -->
    <!-- local SiDataGridHeader idiom.                                  -->
    <!-- ============================================================ -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background"          Value="{StaticResource CardBgRaisedBrush}" />
        <Setter Property="Foreground"          Value="{StaticResource MutedForegroundBrush}" />
        <Setter Property="FontFamily"          Value="Segoe UI Semibold" />
        <Setter Property="FontSize"            Value="10" />
        <Setter Property="Padding"             Value="8,4,8,4" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment"   Value="Center" />
        <Setter Property="BorderBrush"         Value="{StaticResource BorderColBrush}" />
        <Setter Property="BorderThickness"     Value="0,0,0,1" />
        <Setter Property="SeparatorBrush"      Value="{StaticResource BorderColBrush}" />
    </Style>

</ResourceDictionary>
