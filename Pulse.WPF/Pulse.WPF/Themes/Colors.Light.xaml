<!--
    Pulse.WPF — color palette (LIGHT)
    Companion to Colors.xaml. Same keys, light values per UX_REVIEW.md
    Section 2 ("Light theme"). Status hues stay identical — they read on
    both surfaces.
    Wire-up: at runtime, swap the Colors.xaml entry in App.xaml's merged
    dictionary for this file (no Settings toggle yet).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ====== Surfaces ====== -->
    <Color x:Key="AppBg">#F4F6FA</Color>
    <Color x:Key="SurfaceBg">#ECEFF5</Color>
    <Color x:Key="CardBg">#FFFFFF</Color>
    <Color x:Key="CardBgRaised">#F8FAFC</Color>

    <Color x:Key="SidebarBg">#FFFFFF</Color>
    <Color x:Key="SidebarHover">#E6ECF5</Color>
    <Color x:Key="LogBg">#F1F4F9</Color>

    <!-- ====== Borders ====== -->
    <Color x:Key="BorderCol">#D8DEE9</Color>
    <Color x:Key="BorderColStrong">#A7B3C7</Color>

    <!-- ====== Text ====== -->
    <Color x:Key="Foreground">#0F1624</Color>
    <Color x:Key="MutedForeground">#4B5A75</Color>
    <Color x:Key="SubtleForeground">#6B7894</Color>

    <!-- ====== Accents ====== -->
    <Color x:Key="Accent">#2563EB</Color>
    <Color x:Key="AccentDark">#1D4ED8</Color>

    <!-- ====== Status (identical hues to dark — they work on both) ====== -->
    <Color x:Key="Green">#16A34A</Color>
    <Color x:Key="Yellow">#D97706</Color>
    <Color x:Key="Red">#DC2626</Color>
    <Color x:Key="Critical">#B91C1C</Color>
    <Color x:Key="Info">#2563EB</Color>

    <!-- ====== Status pill backgrounds ====== -->
    <Color x:Key="OkBg">#DCFCE7</Color>
    <Color x:Key="WarnBg">#FEF3C7</Color>
    <Color x:Key="ErrBg">#FEE2E2</Color>
    <Color x:Key="CriticalBg">#FECACA</Color>
    <Color x:Key="InfoBg">#DBEAFE</Color>

    <!-- ====== Brushes ====== -->
    <SolidColorBrush x:Key="AppBgBrush"             Color="{StaticResource AppBg}" />
    <SolidColorBrush x:Key="SurfaceBgBrush"         Color="{StaticResource SurfaceBg}" />
    <SolidColorBrush x:Key="CardBgBrush"            Color="{StaticResource CardBg}" />
    <SolidColorBrush x:Key="CardBgRaisedBrush"      Color="{StaticResource CardBgRaised}" />
    <SolidColorBrush x:Key="SidebarBgBrush"         Color="{StaticResource SidebarBg}" />
    <SolidColorBrush x:Key="SidebarHoverBrush"      Color="{StaticResource SidebarHover}" />
    <SolidColorBrush x:Key="LogBgBrush"             Color="{StaticResource LogBg}" />

    <SolidColorBrush x:Key="BorderColBrush"         Color="{StaticResource BorderCol}" />
    <SolidColorBrush x:Key="BorderColStrongBrush"   Color="{StaticResource BorderColStrong}" />

    <SolidColorBrush x:Key="ForegroundBrush"        Color="{StaticResource Foreground}" />
    <SolidColorBrush x:Key="MutedForegroundBrush"   Color="{StaticResource MutedForeground}" />
    <SolidColorBrush x:Key="SubtleForegroundBrush"  Color="{StaticResource SubtleForeground}" />

    <SolidColorBrush x:Key="AccentBrush"            Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="AccentDarkBrush"        Color="{StaticResource AccentDark}" />

    <SolidColorBrush x:Key="GreenBrush"             Color="{StaticResource Green}" />
    <SolidColorBrush x:Key="YellowBrush"            Color="{StaticResource Yellow}" />
    <SolidColorBrush x:Key="RedBrush"               Color="{StaticResource Red}" />
    <SolidColorBrush x:Key="CriticalBrush"          Color="{StaticResource Critical}" />
    <SolidColorBrush x:Key="InfoBrush"              Color="{StaticResource Info}" />

    <SolidColorBrush x:Key="OkBgBrush"              Color="{StaticResource OkBg}" />
    <SolidColorBrush x:Key="WarnBgBrush"            Color="{StaticResource WarnBg}" />
    <SolidColorBrush x:Key="ErrBgBrush"             Color="{StaticResource ErrBg}" />
    <SolidColorBrush x:Key="CriticalBgBrush"        Color="{StaticResource CriticalBg}" />
    <SolidColorBrush x:Key="InfoBgBrush"            Color="{StaticResource InfoBg}" />

</ResourceDictionary>
