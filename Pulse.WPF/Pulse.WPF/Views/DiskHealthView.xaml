<UserControl x:Class="Pulse.WPF.Views.DiskHealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Pulse.WPF.ViewModels"
             xmlns:controls="clr-namespace:Pulse.WPF.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:DiskHealthViewModel, IsDesignTimeCreatable=True}"
             mc:Ignorable="d"
             Background="{StaticResource AppBgBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,24,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- Header -->
                <RowDefinition Height="Auto" />   <!-- Findings -->
                <RowDefinition Height="Auto" />   <!-- 3 summary cards -->
                <RowDefinition Height="Auto" />   <!-- Volumes -->
                <RowDefinition Height="Auto" />   <!-- Pixellot paths -->
                <RowDefinition Height="*" MinHeight="220" />  <!-- Log -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ====== Header ====== -->
            <DockPanel Grid.Row="0" Margin="0,0,0,24">
                <Border DockPanel.Dock="Right" Style="{StaticResource StatusChip}"
                        Background="{Binding StatusBg}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="9" Height="9" Fill="{Binding StatusColor}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold"
                                   Foreground="{Binding StatusColor}" Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <StackPanel>
                    <TextBlock Text="Disk &amp; System Health" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="SMART, free space, and the Pixellot data paths that fill up first"
                               Style="{StaticResource PageSubtitle}" />
                </StackPanel>
            </DockPanel>

            <controls:FindingsBanner Grid.Row="1"
                                     Findings="{Binding Findings}"
                                     Margin="0,0,0,16" />

            <!-- ====== 3 summary cards ====== -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <md:PackIcon Kind="Heart" Width="20" Height="20"
                                         Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="SMART Health" Style="{StaticResource SectionTitle}" Margin="10,0,0,0" />
                            <controls:SeverityChip DockPanel.Dock="Right"
                                                   Severity="{Binding SmartSeverity}"
                                                   Text="{Binding SmartChipText}"
                                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                        </DockPanel>
                        <TextBlock Text="{Binding SmartHealthSummary}"
                                   FontFamily="Segoe UI Semibold" FontSize="18"
                                   Foreground="{StaticResource ForegroundBrush}" Margin="0,12,0,0" />
                        <TextBlock Text="Per-disk health attributes"
                                   Style="{StaticResource MutedLabel}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <md:PackIcon Kind="AlertCircleOutline" Width="20" Height="20"
                                         Foreground="{StaticResource YellowBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Disk &amp; Driver Errors" Style="{StaticResource SectionTitle}" Margin="10,0,0,0" />
                            <controls:SeverityChip DockPanel.Dock="Right"
                                                   Severity="{Binding DiskErrorsSeverity}"
                                                   Text="{Binding DiskErrorsChipText}"
                                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                        </DockPanel>
                        <TextBlock Text="{Binding DiskErrorsSummary}"
                                   FontFamily="Segoe UI Semibold" FontSize="14"
                                   Foreground="{StaticResource ForegroundBrush}"
                                   Margin="0,12,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="From the Windows Event Log (last 48 h)"
                                   Style="{StaticResource MutedLabel}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <md:PackIcon Kind="Harddisk" Width="20" Height="20"
                                         Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="OS Drive" Style="{StaticResource SectionTitle}" Margin="10,0,0,0" />
                            <controls:SeverityChip DockPanel.Dock="Right"
                                                   Severity="{Binding OsDriveSeverity}"
                                                   Text="{Binding OsDriveChipText}"
                                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                        </DockPanel>
                        <TextBlock Text="{Binding OsDriveFreeSummary}"
                                   FontFamily="Segoe UI Semibold" FontSize="14"
                                   Foreground="{StaticResource ForegroundBrush}"
                                   Margin="0,12,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="Drops below 50 GB → Critical"
                                   Style="{StaticResource MutedLabel}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ====== Volumes ====== -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Volumes" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Volumes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Drive}" Style="{StaticResource MonoValue}" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Role}" Foreground="{StaticResource ForegroundBrush}" VerticalAlignment="Center" />
                                    <Grid Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <ProgressBar Maximum="100" Value="{Binding PercentUsedValue}" Height="8"
                                                     Foreground="{Binding BarColor}"
                                                     Background="{StaticResource BorderColBrush}" />
                                    </Grid>
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedForegroundBrush}">
                                        <Run Text="{Binding Free, Mode=OneWay}" />
                                        <Run Text=" free of " />
                                        <Run Text="{Binding Total, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="4" Text="{Binding Status}"
                                               Foreground="{Binding StatusColor}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- ====== Pixellot Storage Paths ====== -->
            <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,0,0,16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Pixellot Storage Paths" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                    <DataGrid ItemsSource="{Binding PixellotPaths}"
                              Background="Transparent"
                              BorderThickness="0"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              IsReadOnly="True"
                              RowBackground="Transparent"
                              AlternatingRowBackground="#10FFFFFF"
                              ColumnHeaderStyle="{x:Null}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MonoValue}">
                                        <Setter Property="Padding" Value="8,0" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
                                        <Setter Property="Padding" Value="8,0" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="Auto">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
                                        <Setter Property="Padding" Value="8,0" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Threshold" Binding="{Binding Threshold}" Width="Auto">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
                                        <Setter Property="Padding" Value="8,0" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding StatusColor}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Padding" Value="8,0" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- ====== Live log ====== -->
            <Border Grid.Row="5" Style="{StaticResource Card}" Margin="0,0,0,16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Live Log" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                    <Border BorderBrush="{StaticResource BorderColBrush}" BorderThickness="0,1,0,0"
                            Background="{StaticResource LogBgBrush}" CornerRadius="6">
                        <ListBox ItemsSource="{Binding LogEntries}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="11">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                   Foreground="{StaticResource MutedForegroundBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Result}"
                                                   Foreground="{Binding ResultColor}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>
            </Border>

            <!-- ====== Action bar ====== -->
            <DockPanel Grid.Row="6">
                <Button DockPanel.Dock="Right"
                        Command="{Binding RunTestCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Padding="22,10" FontWeight="SemiBold"
                        MinWidth="160" MinHeight="44">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <md:PackIcon Kind="Refresh" Width="18" Height="18" VerticalAlignment="Center" />
                        <TextBlock Text="Refresh" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
