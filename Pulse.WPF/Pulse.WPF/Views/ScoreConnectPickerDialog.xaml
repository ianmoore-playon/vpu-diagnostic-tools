<Window x:Class="Pulse.WPF.Views.ScoreConnectPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose a value"
        Width="460" Height="240"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppBgBrush}"
        TextElement.Foreground="{StaticResource ForegroundBrush}"
        TextElement.FontFamily="Segoe UI"
        TextElement.FontSize="13">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText"
                   Text="Choose"
                   FontFamily="Segoe UI Semibold" FontSize="16"
                   Margin="0,0,0,8" />

        <TextBlock Grid.Row="1" x:Name="DescriptionText"
                   Text=""
                   Foreground="{StaticResource MutedForegroundBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,16" />

        <ComboBox Grid.Row="2" x:Name="ValueCombo"
                  VerticalAlignment="Top"
                  DisplayMemberPath="Name"
                  SelectedValuePath="Id" />

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CancelButton" Content="Cancel"
                    Click="CancelButton_Click"
                    Width="100" Height="32" Margin="0,0,8,0" />
            <Button x:Name="OkButton" Content="OK"
                    Click="OkButton_Click"
                    IsDefault="True"
                    Width="100" Height="32"
                    Background="{StaticResource AccentBrush}"
                    Foreground="White" />
        </StackPanel>
    </Grid>
</Window>
