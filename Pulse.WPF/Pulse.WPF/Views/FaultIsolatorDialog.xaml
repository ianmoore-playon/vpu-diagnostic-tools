<Window x:Class="Pulse.WPF.Views.FaultIsolatorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:Pulse.WPF.ViewModels"
        xmlns:controls="clr-namespace:Pulse.WPF.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance Type=vm:FaultIsolatorViewModel}"
        mc:Ignorable="d"
        Title="Camera Fault Isolator"
        Background="{StaticResource AppBgBrush}"
        Foreground="{StaticResource ForegroundBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        Width="780" Height="680"
        MinWidth="640" MinHeight="560"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <!--
        v0.8.5-beta bisection: v0.8.4-beta proved the dialog opens when
        ALL referenced StaticResource styles are stripped. This release
        re-adds every style EXCEPT Style="{StaticResource
        PulseDialogWindow}" on the Window. If it opens, PulseDialogWindow
        is the confirmed culprit and we keep it off this dialog. If it
        fails, the culprit is one of the body styles (Card / SectionTitle
        / MutedLabel / MaterialDesignRaisedButton / SeverityChip).
        Window-level Background / Foreground / Font are still using
        StaticResource brushes (matching the rest of the app); only the
        composite PulseDialogWindow style is held out.
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- =================== Header =================== -->
        <Border Grid.Row="0" Padding="24,18,24,8">
            <StackPanel>
                <TextBlock Text="Camera Fault Isolator"
                           Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageSubtitle}"
                           TextWrapping="Wrap"
                           Text="Walk through a 4-phase swap test to pin a degraded port on a NIC, cable, or camera. The live monitor pauses while this wizard is open." />
            </StackPanel>
        </Border>

        <!-- =================== Step dots =================== -->
        <Border Grid.Row="1" Padding="24,4,24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Grid Width="14" Height="14" Margin="0,0,8,0">
                    <Ellipse Width="14" Height="14"
                             Fill="Transparent"
                             Stroke="{StaticResource MutedForegroundBrush}"
                             StrokeThickness="1" />
                    <Ellipse Width="14" Height="14"
                             Fill="{StaticResource GreenBrush}"
                             Stroke="{StaticResource GreenBrush}"
                             StrokeThickness="1"
                             Visibility="{Binding StepDot1, Converter={StaticResource BoolToVis}}" />
                </Grid>
                <Rectangle Width="32" Height="1" Margin="0,0,8,0"
                           Fill="{StaticResource BorderColBrush}"
                           VerticalAlignment="Center" />

                <Grid Width="14" Height="14" Margin="0,0,8,0">
                    <Ellipse Width="14" Height="14"
                             Fill="Transparent"
                             Stroke="{StaticResource MutedForegroundBrush}"
                             StrokeThickness="1" />
                    <Ellipse Width="14" Height="14"
                             Fill="{StaticResource GreenBrush}"
                             Stroke="{StaticResource GreenBrush}"
                             StrokeThickness="1"
                             Visibility="{Binding StepDot2, Converter={StaticResource BoolToVis}}" />
                </Grid>
                <Rectangle Width="32" Height="1" Margin="0,0,8,0"
                           Fill="{StaticResource BorderColBrush}"
                           VerticalAlignment="Center" />

                <Grid Width="14" Height="14" Margin="0,0,8,0">
                    <Ellipse Width="14" Height="14"
                             Fill="Transparent"
                             Stroke="{StaticResource MutedForegroundBrush}"
                             StrokeThickness="1" />
                    <Ellipse Width="14" Height="14"
                             Fill="{StaticResource GreenBrush}"
                             Stroke="{StaticResource GreenBrush}"
                             StrokeThickness="1"
                             Visibility="{Binding StepDot3, Converter={StaticResource BoolToVis}}" />
                </Grid>
                <Rectangle Width="32" Height="1" Margin="0,0,8,0"
                           Fill="{StaticResource BorderColBrush}"
                           VerticalAlignment="Center" />

                <Grid Width="14" Height="14" Margin="0,0,8,0">
                    <Ellipse Width="14" Height="14"
                             Fill="Transparent"
                             Stroke="{StaticResource MutedForegroundBrush}"
                             StrokeThickness="1" />
                    <Ellipse Width="14" Height="14"
                             Fill="{StaticResource GreenBrush}"
                             Stroke="{StaticResource GreenBrush}"
                             StrokeThickness="1"
                             Visibility="{Binding StepDot4, Converter={StaticResource BoolToVis}}" />
                </Grid>
                <Rectangle Width="32" Height="1" Margin="0,0,8,0"
                           Fill="{StaticResource BorderColBrush}"
                           VerticalAlignment="Center" />

                <Grid Width="14" Height="14" Margin="0,0,8,0">
                    <Ellipse Width="14" Height="14"
                             Fill="Transparent"
                             Stroke="{StaticResource MutedForegroundBrush}"
                             StrokeThickness="1" />
                    <Ellipse Width="14" Height="14"
                             Fill="{StaticResource GreenBrush}"
                             Stroke="{StaticResource GreenBrush}"
                             StrokeThickness="1"
                             Visibility="{Binding StepDot5, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- =================== Body =================== -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="24,0,24,8">
            <StackPanel>

                <!-- Phase title + instruction -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{Binding PhaseTitle}"
                                   Style="{StaticResource SectionTitle}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="{Binding PhaseInstruction}"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource ForegroundBrush}"
                                   FontSize="13" />
                    </StackPanel>
                </Border>

                <!-- Port selectors -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Suspect port"
                                       Style="{StaticResource MutedLabel}"
                                       Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding SuspectPortChoices}"
                                      SelectedItem="{Binding SelectedSuspectPort}"
                                      DisplayMemberPath="DisplayLabel"
                                      IsEnabled="{Binding IsPickingSuspectPort}"
                                      MinHeight="36" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="Test port (known-good)"
                                       Style="{StaticResource MutedLabel}"
                                       Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding TestPortChoices}"
                                      SelectedItem="{Binding SelectedTestPort}"
                                      DisplayMemberPath="DisplayLabel"
                                      IsEnabled="{Binding IsPickingTestPort}"
                                      MinHeight="36" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Latest result -->
                <Border Style="{StaticResource Card}"
                        Margin="0,0,0,12"
                        Visibility="{Binding ResultText, Converter={StaticResource StringToVis}, FallbackValue=Collapsed}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="LATEST RESULT" Style="{StaticResource MutedLabel}" />
                            <controls:SeverityChip Text="{Binding ResultSeverityLabel, FallbackValue=INFO}"
                                                   Severity="{Binding ResultSeverity, FallbackValue=info}"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding ResultText}"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource ForegroundBrush}"
                                   FontSize="13" />
                    </StackPanel>
                </Border>

                <!-- History -->
                <Border Style="{StaticResource Card}"
                        Margin="0,0,0,12"
                        Visibility="{Binding History.Count, Converter={StaticResource CountToVis}}">
                    <StackPanel>
                        <TextBlock Text="Phase history" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderColBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,6,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="68" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0"
                                                       Text="{Binding TimestampLabel}"
                                                       FontFamily="Cascadia Mono, Consolas"
                                                       FontSize="11"
                                                       Foreground="{StaticResource MutedForegroundBrush}" />
                                            <controls:SeverityChip Grid.Row="0" Grid.Column="1"
                                                                   Text="{Binding SeverityLabel}"
                                                                   Severity="{Binding Severity}" />
                                            <TextBlock Grid.Row="0" Grid.Column="2"
                                                       Text="{Binding PhaseName}"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       Foreground="{StaticResource ForegroundBrush}" />
                                            <TextBlock Grid.Row="1" Grid.Column="2"
                                                       Text="{Binding Configuration}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource MutedForegroundBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0" />
                                            <TextBlock Grid.Row="2" Grid.Column="2"
                                                       Text="{Binding Verdict}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource ForegroundBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- =================== Footer =================== -->
        <Border Grid.Row="3" Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource BorderColBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12,24,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Start Over"
                            Command="{Binding StartOverCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            MinWidth="120" MinHeight="40" />
                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            MinWidth="120" MinHeight="40"
                            Margin="12,0,0,0"
                            IsCancel="True" />
                    <!-- v0.8.6-beta: "No spare CHU" path on Phase 4. Visible
                         only while Phase == AwaitingCameraTest (gated by
                         CanInferCameraConclusion). Field tech feedback:
                         spare cameras (CHUs) are rare; without one, the
                         tech needs an exit that produces a useful verdict
                         instead of being stuck. -->
                    <Button Content="No spare CHU — infer"
                            Command="{Binding InferCameraConclusionCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            MinWidth="180" MinHeight="40"
                            Margin="12,0,0,0"
                            Visibility="{Binding CanInferCameraConclusion, Converter={StaticResource BoolToVis}}" />
                    <Button Content="{Binding ActionButtonLabel}"
                            Command="{Binding ActionCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            MinWidth="180" MinHeight="40"
                            Margin="12,0,0,0"
                            IsDefault="True" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
