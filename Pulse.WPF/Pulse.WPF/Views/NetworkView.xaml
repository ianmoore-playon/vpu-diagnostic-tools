<UserControl x:Class="Pulse.WPF.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Pulse.WPF.ViewModels"
             xmlns:controls="clr-namespace:Pulse.WPF.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:NetworkViewModel, IsDesignTimeCreatable=True}"
             mc:Ignorable="d"
             Background="{StaticResource AppBgBrush}">

    <UserControl.Resources>
        <!-- Local style: a compact "sub-card" used inside the combined
             Internet+IP card and inside the TCP/UDP split, so each half-card
             gets a subtle background separator without the full Card padding. -->
        <Style x:Key="NetSubCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,12,14,12" />
        </Style>

        <Style x:Key="NetSubHeading" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,24,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- 0: Section header -->
                <RowDefinition Height="Auto" />   <!-- 1: Findings banner -->
                <RowDefinition Height="Auto" />   <!-- 2: Recommended Actions (auto-collapse) -->
                <RowDefinition Height="Auto" />   <!-- 3: Port Connectivity (TCP | UDP) -->
                <RowDefinition Height="Auto" />   <!-- 4: Combined Internet+IP | Domain reachability -->
                <RowDefinition Height="*" MinHeight="200" /> <!-- 5: Live Log -->
                <RowDefinition Height="Auto" />   <!-- 6: Action bar -->
            </Grid.RowDefinitions>

            <!-- ====== Section header ====== -->
            <DockPanel Grid.Row="0" Margin="0,0,0,24">
                <Border DockPanel.Dock="Right" Style="{StaticResource StatusChip}"
                        Background="{Binding StatusBg}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="9" Height="9" Fill="{Binding StatusColor}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold"
                                   Foreground="{Binding StatusColor}" Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <StackPanel>
                    <TextBlock Text="Network Configuration" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Adapters, IP, NTP and reachability — what the box can talk to right now"
                               Style="{StaticResource PageSubtitle}" />
                </StackPanel>
            </DockPanel>

            <!-- ====== Findings banner — auto-collapses when empty ====== -->
            <controls:FindingsBanner Grid.Row="1"
                                     Findings="{Binding Findings}"
                                     Margin="0,0,0,16" />

            <!-- ====== Recommended Actions (top — auto-collapse when empty) ======
                 Bound to Recommendations.Count via CountToVis, so the panel is
                 only present when there is at least one actionable item. -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,16"
                    Visibility="{Binding Recommendations.Count, Converter={StaticResource CountToVis}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <md:PackIcon DockPanel.Dock="Left" Kind="AlertCircleOutline"
                                     Width="20" Height="20"
                                     Foreground="{StaticResource YellowBrush}"
                                     VerticalAlignment="Center" />
                        <TextBlock Text="Recommended Actions" Style="{StaticResource SectionTitle}"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Recommendations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding SeverityBg}"
                                        CornerRadius="6"
                                        Padding="12,10"
                                        Margin="0,0,0,8">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{Binding SeverityColor}"
                                                    CornerRadius="3" Padding="6,1"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Severity}"
                                                           Foreground="White"
                                                           FontWeight="SemiBold" FontSize="10" />
                                            </Border>
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource ForegroundBrush}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Body}"
                                                   Foreground="{StaticResource ForegroundBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Open Adapter Settings"
                            Command="{Binding OpenAdapterSettingsCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            HorizontalAlignment="Left" Margin="0,8,0,0"
                            MinWidth="180" MinHeight="40" />
                </StackPanel>
            </Border>

            <!-- ====== Port Connectivity (split: TCP | UDP) — page focus ====== -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Port Connectivity" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- TCP column -->
                        <Border Grid.Column="0" Style="{StaticResource NetSubCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <Border DockPanel.Dock="Right"
                                            Background="{StaticResource AccentBrush}"
                                            CornerRadius="3" Padding="8,2"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="TCP" FontWeight="SemiBold"
                                                   FontSize="10" Foreground="White" />
                                    </Border>
                                    <TextBlock Text="TCP ports" Style="{StaticResource NetSubHeading}"
                                               Margin="0" VerticalAlignment="Center" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding TcpPortTests}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource AppBgBrush}"
                                                    BorderBrush="{StaticResource BorderColBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Width="200" Margin="0,0,10,10"
                                                    Padding="12,10">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Port}"
                                                               FontSize="28" FontWeight="Bold"
                                                               Foreground="{StaticResource ForegroundBrush}" />
                                                    <TextBlock Text="{Binding Purpose}"
                                                               Foreground="{StaticResource ForegroundBrush}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,2,0,0" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                        <Ellipse Width="10" Height="10"
                                                                 Fill="{Binding ResultColor}"
                                                                 VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Status}"
                                                                   Foreground="{Binding ResultColor}"
                                                                   FontWeight="SemiBold"
                                                                   Margin="8,0,0,0"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Host}"
                                                               Style="{StaticResource MutedLabel}"
                                                               FontSize="11"
                                                               Margin="0,6,0,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- UDP column -->
                        <Border Grid.Column="2" Style="{StaticResource NetSubCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <Border DockPanel.Dock="Right"
                                            Background="{StaticResource YellowBrush}"
                                            CornerRadius="3" Padding="8,2"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="UDP" FontWeight="SemiBold"
                                                   FontSize="10" Foreground="White" />
                                    </Border>
                                    <TextBlock Text="UDP ports" Style="{StaticResource NetSubHeading}"
                                               Margin="0" VerticalAlignment="Center" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding UdpPortTests}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource AppBgBrush}"
                                                    BorderBrush="{StaticResource BorderColBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Width="200" Margin="0,0,10,10"
                                                    Padding="12,10">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Port}"
                                                               FontSize="28" FontWeight="Bold"
                                                               Foreground="{StaticResource ForegroundBrush}" />
                                                    <TextBlock Text="{Binding Purpose}"
                                                               Foreground="{StaticResource ForegroundBrush}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,2,0,0" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                        <Ellipse Width="10" Height="10"
                                                                 Fill="{Binding ResultColor}"
                                                                 VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Status}"
                                                                   Foreground="{Binding ResultColor}"
                                                                   FontWeight="SemiBold"
                                                                   Margin="8,0,0,0"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Host}"
                                                               Style="{StaticResource MutedLabel}"
                                                               FontSize="11"
                                                               Margin="0,6,0,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ====== Combined Internet+IP card | Domain reachability ====== -->
            <Grid Grid.Row="4" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="420" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" MinWidth="260" />
                </Grid.ColumnDefinitions>

                <!-- Combined Internet adapter + IP configuration in one Card,
                     internally split into two sub-cards side-by-side. -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Internet Adapter &amp; IP Configuration"
                                   Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Sub-card A: Internet adapter -->
                            <Border Grid.Column="0" Style="{StaticResource NetSubCard}">
                                <StackPanel>
                                    <TextBlock Text="ADAPTER" Style="{StaticResource NetSubHeading}" />
                                    <StackPanel Visibility="{Binding HasPrimaryAdapter, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding PrimaryAdapter.Name}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource ForegroundBrush}"
                                                   TextWrapping="Wrap" />
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="IP address:"
                                                       Style="{StaticResource MutedLabel}" />
                                            <TextBlock Grid.Row="0" Grid.Column="1"
                                                       Text="{Binding PrimaryAdapter.Ip}"
                                                       Style="{StaticResource MonoValue}" />

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Link state:"
                                                       Style="{StaticResource MutedLabel}" Margin="0,4,0,0" />
                                            <TextBlock Grid.Row="1" Grid.Column="1"
                                                       Text="{Binding PrimaryAdapter.LinkState}"
                                                       Foreground="{StaticResource GreenBrush}"
                                                       FontWeight="SemiBold" Margin="0,4,0,0" />

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Link speed:"
                                                       Style="{StaticResource MutedLabel}" Margin="0,4,0,0" />
                                            <TextBlock Grid.Row="2" Grid.Column="1"
                                                       Text="{Binding PrimaryAdapter.Speed}"
                                                       Style="{StaticResource MonoValue}" Margin="0,4,0,0" />
                                        </Grid>
                                    </StackPanel>
                                    <TextBlock Text="No internet-bound adapter detected."
                                               Foreground="{StaticResource MutedForegroundBrush}"
                                               Visibility="{Binding HasPrimaryAdapter,
                                                            Converter={StaticResource BoolToVis},
                                                            ConverterParameter=Invert}" />
                                </StackPanel>
                            </Border>

                            <!-- Sub-card B: IP configuration -->
                            <Border Grid.Column="2" Style="{StaticResource NetSubCard}">
                                <StackPanel>
                                    <TextBlock Text="IP CONFIGURATION" Style="{StaticResource NetSubHeading}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="IP address:"
                                                   Style="{StaticResource MutedLabel}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding IpConfig.IpAddress}"
                                                   Style="{StaticResource MonoValue}" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Assignment:"
                                                   Style="{StaticResource MutedLabel}" Margin="0,4,0,0" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding IpAssignment}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource ForegroundBrush}"
                                                   Margin="0,4,0,0" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Subnet mask:"
                                                   Style="{StaticResource MutedLabel}" Margin="0,4,0,0" />
                                        <TextBlock Grid.Row="2" Grid.Column="1"
                                                   Text="{Binding IpConfig.SubnetMask}"
                                                   Style="{StaticResource MonoValue}" Margin="0,4,0,0" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Gateway:"
                                                   Style="{StaticResource MutedLabel}" Margin="0,4,0,0" />
                                        <TextBlock Grid.Row="3" Grid.Column="1"
                                                   Text="{Binding IpConfig.Gateway}"
                                                   Style="{StaticResource MonoValue}" Margin="0,4,0,0" />

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="DNS:"
                                                   Style="{StaticResource MutedLabel}" Margin="0,4,0,0" />
                                        <TextBlock Grid.Row="4" Grid.Column="1"
                                                   Text="{Binding IpConfig.DnsServers}"
                                                   Style="{StaticResource MonoValue}" Margin="0,4,0,0"
                                                   TextWrapping="Wrap" />

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="NTP server:"
                                                   Style="{StaticResource MutedLabel}" Margin="0,8,0,0" />
                                        <TextBlock Grid.Row="5" Grid.Column="1"
                                                   Text="{Binding IpConfig.NtpServer}"
                                                   Style="{StaticResource MonoValue}" Margin="0,8,0,0" />

                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="NTP source:"
                                                   Style="{StaticResource MutedLabel}" Margin="0,4,0,0" />
                                        <TextBlock Grid.Row="6" Grid.Column="1"
                                                   Text="{Binding IpConfig.NtpSource}"
                                                   Foreground="{StaticResource MutedForegroundBrush}"
                                                   Margin="0,4,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Domain reachability — secondary side tile -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Domain reachability"
                                   Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding DomainTests}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Domain}"
                                                   Style="{StaticResource MonoValue}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Status}"
                                                   Foreground="{Binding ResultColor}"
                                                   FontWeight="SemiBold" Margin="8,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ====== Live Log ====== -->
            <Border Grid.Row="5" Style="{StaticResource Card}" Margin="0,0,0,16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Live Log"
                               Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                    <Border BorderBrush="{StaticResource BorderColBrush}" BorderThickness="0,1,0,0"
                            Background="{StaticResource LogBgBrush}" CornerRadius="6"
                            MaxHeight="260">
                        <ListBox ItemsSource="{Binding LogEntries}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="11">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                   Foreground="{StaticResource MutedForegroundBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Result}"
                                                   Foreground="{Binding ResultColor}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>
            </Border>

            <!-- ====== Action bar ====== -->
            <DockPanel Grid.Row="6">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Export Report"
                            Style="{StaticResource MaterialDesignOutlinedButton}" IsEnabled="False" />
                </StackPanel>
                <Button DockPanel.Dock="Right"
                        Command="{Binding RunTestCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Padding="22,10" FontWeight="SemiBold"
                        MinWidth="160" MinHeight="44">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <md:PackIcon Kind="Play" Width="18" Height="18" VerticalAlignment="Center" />
                        <TextBlock Text="Run Test" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
