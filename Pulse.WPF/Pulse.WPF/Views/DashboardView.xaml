<UserControl x:Class="Pulse.WPF.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Pulse.WPF.ViewModels"
             xmlns:controls="clr-namespace:Pulse.WPF.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel, IsDesignTimeCreatable=True}"
             mc:Ignorable="d"
             Background="{StaticResource AppBgBrush}">

    <UserControl.Resources>
        <!-- Compact KV row for the network/identity cards. -->
        <Style x:Key="KvLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
            <Setter Property="Margin" Value="0,2,8,2" />
        </Style>
        <Style x:Key="KvValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="Margin" Value="0,2,0,2" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="CardCaption" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- Findings row — entire row is a button that navigates to the
             matching panel via the parent VM's NavigateCommand. Hover shows
             the technical Detail in the tooltip so engineers still see the
             raw value (Source / actual error string) without the operator-
             facing Title carrying jargon. (UX review recs #4, #9, #10.) -->
        <DataTemplate x:Key="FindingRowTemplate">
            <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="0,4,0,4"
                    HorizontalContentAlignment="Stretch" Cursor="Hand"
                    Command="{Binding DataContext.NavigateCommand,
                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding TargetNav}"
                    ToolTip="{Binding Detail}"
                    AutomationProperties.Name="{Binding Title}"
                    AutomationProperties.HelpText="{Binding Detail}">
                <DockPanel>
                    <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource MutedForegroundBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Severity}" Value="ok">
                                        <Setter Property="Fill" Value="{StaticResource GreenBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Severity}" Value="warn">
                                        <Setter Property="Fill" Value="{StaticResource YellowBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Severity}" Value="fail">
                                        <Setter Property="Fill" Value="{StaticResource RedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <md:PackIcon DockPanel.Dock="Right" Kind="ChevronRight"
                                 Width="14" Height="14" VerticalAlignment="Center"
                                 Foreground="{StaticResource SubtleForegroundBrush}" Margin="12,0,0,0" />
                    <!-- U2 fix: prefix the row with the panel that emitted
                         the finding (e.g. "[Network]  ..."). Previously the
                         row showed only Title, so a tech reading "Smart
                         attribute over threshold" had no clue which panel
                         owned the issue. Source / TargetNav was already
                         being populated by the building VMs. -->
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="["
                             Foreground="{StaticResource SubtleForegroundBrush}"
                             FontSize="{StaticResource FontSize.Body}" />
                        <Run Text="{Binding Source}"
                             Foreground="{StaticResource MutedForegroundBrush}"
                             FontSize="{StaticResource FontSize.Body}" />
                        <Run Text="]  "
                             Foreground="{StaticResource SubtleForegroundBrush}"
                             FontSize="{StaticResource FontSize.Body}" />
                        <Run Text="{Binding Title}"
                             Foreground="{StaticResource ForegroundBrush}"
                             FontSize="{StaticResource FontSize.Body}" />
                    </TextBlock>
                </DockPanel>
            </Button>
        </DataTemplate>

        <!-- NIC port row -->
        <DataTemplate x:Key="NicPortRowTemplate">
            <Grid Margin="0,3,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding PortNumber, StringFormat='Port {0}'}"
                           FontFamily="Segoe UI Semibold" FontSize="{StaticResource FontSize.Small}"
                           Foreground="{StaticResource ForegroundBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding Name}"
                           FontFamily="Consolas" FontSize="{StaticResource FontSize.Small}"
                           Foreground="{StaticResource SubtleForegroundBrush}"
                           TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                <TextBlock Grid.Column="2" Text="{Binding SpeedLabel}"
                           FontFamily="Consolas" FontSize="{StaticResource FontSize.Small}"
                           Foreground="{StaticResource SubtleForegroundBrush}"
                           TextAlignment="Right" Margin="0,0,12,0" />
                <Border Grid.Column="3" CornerRadius="3" Padding="6,1,6,1"
                        BorderThickness="1" BorderBrush="{Binding StatusColor}"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" FontSize="{StaticResource FontSize.Small}"
                               Foreground="{Binding StatusColor}" FontWeight="SemiBold" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Service-status row -->
        <DataTemplate x:Key="ServiceRowTemplate">
            <Grid Margin="0,3,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                           Foreground="{StaticResource ForegroundBrush}"
                           FontSize="{StaticResource FontSize.Body}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                <Border Grid.Column="1" CornerRadius="3" Padding="6,1,6,1"
                        BorderThickness="1" BorderBrush="{Binding StatusColor}">
                    <TextBlock Text="{Binding Status}" FontSize="{StaticResource FontSize.Small}"
                               Foreground="{Binding StatusColor}" FontWeight="SemiBold" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Volume row — two-line layout per drive:
               · Top: drive letter + volume label + role badge   |   used %
               · Bottom: progress bar  |  free / total -->
        <DataTemplate x:Key="VolumeRowTemplate">
            <Border Margin="0,6,0,6" Padding="0">
                <StackPanel>
                    <!-- Top line: identity left, percent right -->
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding PercentUsed}"
                                   FontFamily="Segoe UI Semibold" FontSize="{StaticResource FontSize.Body}"
                                   Foreground="{Binding StatusColor}"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Drive}"
                                       FontFamily="Segoe UI Semibold" FontSize="{StaticResource FontSize.Mono}"
                                       Foreground="{StaticResource ForegroundBrush}"
                                       VerticalAlignment="Center" />
                            <!-- Volume label only renders when populated. -->
                            <TextBlock Text="{Binding Label}"
                                       FontSize="{StaticResource FontSize.Body}"
                                       Foreground="{StaticResource SubtleForegroundBrush}"
                                       Margin="{StaticResource Spacing.InlineLeft}" VerticalAlignment="Center"
                                       Visibility="{Binding Label, Converter={StaticResource StringToVis}}" />
                            <!-- Role badge: "OS Drive", "Recording / Storage", etc. -->
                            <Border Background="{StaticResource BorderColBrush}"
                                    CornerRadius="3" Padding="6,1,6,1" Margin="{StaticResource Spacing.InlineLeftLg}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Role}"
                                           FontSize="{StaticResource FontSize.Caption}"
                                           Foreground="{StaticResource MutedForegroundBrush}" />
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <!-- Bottom line: bar + free/total -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0" Minimum="0" Maximum="100"
                                     Value="{Binding PercentUsedValue}" Height="6"
                                     Foreground="{Binding BarColor}"
                                     VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="1"
                                   Foreground="{StaticResource SubtleForegroundBrush}"
                                   FontSize="{StaticResource FontSize.Small}" TextAlignment="Right"
                                   VerticalAlignment="Center">
                            <Run Text="{Binding Free, Mode=OneWay}" />
                            <Run Text=" free of " />
                            <Run Text="{Binding Total, Mode=OneWay}" />
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SubsystemTileTemplate">
            <Button Style="{StaticResource SubsystemHealthTile}"
                    Command="{Binding DataContext.NavigateCommand,
                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding TargetNav}"
                    Margin="0,0,8,8"
                    AutomationProperties.Name="{Binding Title}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
                        <Border DockPanel.Dock="Right"
                                Background="{Binding StatusBg}"
                                CornerRadius="9"
                                Padding="7,2,7,2"
                                Margin="8,0,0,0">
                            <TextBlock Text="{Binding StatusText}"
                                       FontFamily="Segoe UI Semibold"
                                       FontSize="{StaticResource FontSize.Caption}"
                                       Foreground="{Binding StatusColor}" />
                        </Border>
                        <md:PackIcon DockPanel.Dock="Left"
                                     Kind="{Binding IconKind}"
                                     Width="17" Height="17"
                                     Foreground="{StaticResource AccentBrush}"
                                     VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Title}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI Semibold"
                                   FontSize="{StaticResource FontSize.Body}"
                                   Foreground="{StaticResource ForegroundBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock Grid.Row="1"
                               Text="{Binding Description}"
                               Margin="0,8,0,0"
                               Foreground="{StaticResource MutedForegroundBrush}"
                               FontSize="{StaticResource FontSize.Small}"
                               TextWrapping="Wrap"
                               MaxHeight="34" />
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,24,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- Header strip (title + Refresh + pill) -->
                <RowDefinition Height="Auto" />   <!-- Command center cockpit -->
                <RowDefinition Height="Auto" />   <!-- v0.5.6 baseline banner -->
                <RowDefinition Height="Auto" />   <!-- Empty-state card (non-VPU host) -->
                <RowDefinition Height="Auto" />   <!-- Active Findings (top of page so issues land first) -->
                <RowDefinition Height="Auto" />   <!-- Identity / Pixellot SW cards -->
                <RowDefinition Height="Auto" />   <!-- System Status gauges -->
                <RowDefinition Height="Auto" />   <!-- NIC ports + Network config -->
                <RowDefinition Height="Auto" />   <!-- Storage + Services -->
                <RowDefinition Height="Auto" />   <!-- Quick Nav (hub tiles) -->
            </Grid.RowDefinitions>

            <!-- ====== Header (v0.5.4 top-bar buttons) ======
                 Title left, status pill far-right, action buttons docked
                 between the title and the pill — the place a tech reaches
                 for actions per v0.5.4 field feedback. Status pill docks
                 first so the action buttons sit between title + pill, not
                 inside the pill's container. -->
            <DockPanel Grid.Row="0" Margin="{StaticResource Spacing.PageLg}" LastChildFill="True">
                <Border DockPanel.Dock="Right" Style="{StaticResource StatusChip}"
                        Background="{Binding StatusBg}" Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Overall status"
                        AutomationProperties.HelpText="{Binding StatusLabel}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="9" Height="9" Fill="{Binding StatusColor}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold"
                                   Foreground="{Binding StatusColor}" Margin="{StaticResource Spacing.InlineLeft}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- v0.5.6 — Re-run Baseline button. Fires the same
                         orchestrator that runs once on app launch. The
                         AsyncCommand disables itself while a run is in
                         flight, so the button greys out for the duration. -->
                    <Button Command="{Binding RerunBaselineCommand}"
                            Style="{StaticResource TopBarOutlinedButton}"
                            Margin="0,0,8,0"
                            ToolTip="Run the full diagnostics baseline across all panels.">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <md:PackIcon Kind="PlayCircleOutline" Width="16" Height="16" VerticalAlignment="Center"
                                         Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="Run All Diagnostics" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding GenerateSupportBundleCommand}"
                            Style="{StaticResource TopBarOutlinedButton}"
                            Margin="0,0,8,0"
                            ToolTip="Create a support bundle with the latest baseline, panel reports, and app log.">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <md:PackIcon Kind="FileDocumentOutline" Width="16" Height="16" VerticalAlignment="Center"
                                         Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="Support Bundle" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RefreshCommand}"
                            Style="{StaticResource TopBarPrimaryButton}"
                            ToolTip="Refresh the Dashboard snapshot without running every panel test.">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <md:PackIcon Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center"
                                         Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="Refresh Dashboard" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding VpuLabel}"
                               Style="{StaticResource PageSubtitle}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>

            <!-- ====== Command Center ======
                 First-viewport triage cockpit: verdict, baseline state,
                 compact vitals, top findings, and subsystem drill-downs. -->
            <Border Grid.Row="1" Style="{StaticResource DashboardHeroSurface}" Margin="{StaticResource Spacing.PageLg}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.08*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="0.92*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="COMMAND CENTER" Style="{StaticResource CardCaption}" />
                        <!-- U3 fix: the page-header already renders a
                             StatusChip with StatusLabel. The inner
                             Command-Center version below was a duplicate
                             pill (third copy of the same word in the same
                             viewport — header pill + hero text + inner pill).
                             Dropped the inner Border; the 32-pt hero text
                             still communicates the overall state. -->
                        <StackPanel>
                            <TextBlock Text="{Binding StatusLabel}"
                                       FontFamily="Segoe UI Semibold"
                                       FontSize="32"
                                       Foreground="{Binding StatusColor}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding VpuLabel}"
                                       Foreground="{StaticResource MutedForegroundBrush}"
                                       FontSize="{StaticResource FontSize.Heading}"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Border Background="{Binding BaselineSummaryBg}"
                                BorderBrush="{Binding BaselineSummaryColor}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,7"
                                Margin="0,18,0,0">
                            <DockPanel>
                                <md:PackIcon DockPanel.Dock="Left"
                                             Kind="Speedometer"
                                             Width="17" Height="17"
                                             Foreground="{Binding BaselineSummaryColor}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,8,0" />
                                <TextBlock Text="{Binding BaselineSummaryText}"
                                           Foreground="{Binding BaselineSummaryColor}"
                                           FontFamily="Segoe UI Semibold"
                                           FontSize="{StaticResource FontSize.Body}"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Border>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardFlat}" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="CPU" Style="{StaticResource MetaSm}" />
                                    <TextBlock Text="{Binding CpuPctText}" Style="{StaticResource SectionTitle}"
                                               Foreground="{Binding CpuColor}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardFlat}" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="MEMORY" Style="{StaticResource MetaSm}" />
                                    <TextBlock Text="{Binding MemPctText}" Style="{StaticResource SectionTitle}"
                                               Foreground="{Binding MemColor}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource CardFlat}" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="DISK" Style="{StaticResource MetaSm}" />
                                    <TextBlock Text="{Binding DiskPctText}" Style="{StaticResource SectionTitle}"
                                               Foreground="{Binding DiskColor}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="6" Style="{StaticResource CardFlat}" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="INTERNET" Style="{StaticResource MetaSm}" />
                                    <TextBlock Text="{Binding InternetText}" Style="{StaticResource SectionTitle}"
                                               Foreground="{Binding InternetColor}" Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding CommandOverflowFindingsCount, StringFormat='{}{0} more below'}"
                                       FontSize="{StaticResource FontSize.Small}"
                                       Foreground="{StaticResource MutedForegroundBrush}"
                                       Visibility="{Binding HasCommandOverflowFindings, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="TOP FINDINGS"
                                       FontFamily="Segoe UI Semibold"
                                       FontSize="{StaticResource FontSize.Body}"
                                       Foreground="{StaticResource ForegroundBrush}" />
                        </DockPanel>

                        <Border Style="{StaticResource CardFlat}"
                                Padding="12"
                                Margin="0,10,0,14"
                                Visibility="{Binding HasNoFindings, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <md:PackIcon DockPanel.Dock="Left"
                                             Kind="CheckCircleOutline"
                                             Width="18" Height="18"
                                             Foreground="{StaticResource GreenBrush}"
                                             Margin="0,0,10,0" />
                                <TextBlock Text="No active findings detected in the latest snapshot."
                                           Foreground="{StaticResource MutedForegroundBrush}"
                                           TextWrapping="Wrap" />
                            </DockPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding CommandFindings}"
                                      ItemTemplate="{StaticResource FindingRowTemplate}"
                                      Margin="0,8,0,14"
                                      Visibility="{Binding CommandFindings.Count, Converter={StaticResource CountToVis}}" />

                        <TextBlock Text="SUBSYSTEMS"
                                   FontFamily="Segoe UI Semibold"
                                   FontSize="{StaticResource FontSize.Body}"
                                   Foreground="{StaticResource ForegroundBrush}"
                                   Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding Tiles}"
                                      ItemTemplate="{StaticResource SubsystemTileTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ====== v0.5.6 Baseline Banner ======
                 Shows while the startup baseline orchestrator is running
                 ("Gathering baseline — Network probing (4/8 done)…") and
                 swaps to a "complete" message with a Dismiss button after
                 Completed fires. Auto-dismisses after 10 s — see
                 DashboardViewModel.OnBaselineCompleted. Banner is collapsed
                 entirely when neither IsBaselineRunning nor BaselineComplete
                 is true (i.e. before the first run + after dismissal). -->
            <Border Grid.Row="2" Style="{StaticResource CardElev2}" Margin="{StaticResource Spacing.PageLg}"
                    Visibility="{Binding IsBaselineBannerVisible, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <md:PackIcon DockPanel.Dock="Left" Kind="Speedometer"
                                 Width="22" Height="22"
                                 Foreground="{StaticResource AccentBrush}"
                                 VerticalAlignment="Center" Margin="0,0,16,0" />
                    <!-- Dismiss button only visible after Completed fires.
                         Manual click here also stops the auto-dismiss timer. -->
                    <Button DockPanel.Dock="Right"
                            Command="{Binding DismissBaselineBannerCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Padding="8,2,8,2" MinWidth="0"
                            Visibility="{Binding BaselineComplete, Converter={StaticResource BoolToVis}}"
                            ToolTip="Dismiss this banner.">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Close" Width="14" Height="14" VerticalAlignment="Center"
                                         Foreground="{StaticResource MutedForegroundBrush}" />
                            <TextBlock Text="Dismiss" Margin="6,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedForegroundBrush}" />
                        </StackPanel>
                    </Button>
                    <StackPanel>
                        <!-- Running caption — shown while IsBaselineRunning. -->
                        <TextBlock Text="{Binding BaselineStatusText}"
                                   FontFamily="Segoe UI Semibold" FontSize="14"
                                   Foreground="{StaticResource ForegroundBrush}"
                                   Visibility="{Binding IsBaselineRunning, Converter={StaticResource BoolToVis}}" />
                        <!-- Completed caption — shown while BaselineComplete
                             before the 10 s auto-dismiss timer fires. -->
                        <TextBlock Text="{Binding BaselineResultText}"
                                   FontFamily="Segoe UI Semibold" FontSize="14"
                                   Foreground="{StaticResource ForegroundBrush}"
                                   Visibility="{Binding BaselineComplete, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="Running diagnostics across all panels…"
                                   Foreground="{StaticResource MutedForegroundBrush}"
                                   FontSize="{StaticResource FontSize.Body}" Margin="0,4,0,0"
                                   Visibility="{Binding IsBaselineRunning, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ====== Empty-state card (non-VPU host) ======
                 Top-of-page banner that fires when DashboardService can't
                 find Pixellot at all (registry blank, no agent log, no
                 services). Stops a clean dev box from masquerading as a
                 healthy VPU. (UX review rec #12.) -->
            <Border Grid.Row="3" Style="{StaticResource CardElev2}" Margin="{StaticResource Spacing.PageLg}"
                    Visibility="{Binding IsNonVpuHost, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <md:PackIcon DockPanel.Dock="Left" Kind="InformationOutline"
                                 Width="22" Height="22"
                                 Foreground="{StaticResource AccentBrush}"
                                 VerticalAlignment="Center" Margin="0,0,16,0" />
                    <StackPanel>
                        <TextBlock Text="Pixellot software not detected"
                                   FontFamily="Segoe UI Semibold" FontSize="14"
                                   Foreground="{StaticResource ForegroundBrush}" />
                        <TextBlock Foreground="{StaticResource MutedForegroundBrush}"
                                   FontSize="{StaticResource FontSize.Body}" Margin="{StaticResource Spacing.RowGap}" TextWrapping="Wrap">
                            <Run Text="This host doesn't appear to be a Pixellot VPU — system metrics below are still live, but expect blank values for VPU identity, services, and the diagnostic report. " />
                            <Run Text="Run the tool on a real VPU to see the full dashboard." />
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ====== Active Findings (top of page so issues land first) ======
                 Hidden when there are zero findings — a clean dashboard
                 should not advertise an empty issues card. CardElev2 gives
                 it a slight lift so the eye registers it before the
                 identity / status rows below. -->
            <Border Grid.Row="4" Style="{StaticResource CardElev2}" Margin="{StaticResource Spacing.PageLg}"
                    Visibility="{Binding Findings.Count, Converter={StaticResource CountToVis}}">
                <StackPanel>
                    <DockPanel>
                        <md:PackIcon DockPanel.Dock="Left" Kind="AlertOutline"
                                     Width="22" Height="22"
                                     Foreground="{StaticResource YellowBrush}" VerticalAlignment="Center" />
                        <!-- Count badge sits at the right edge of the header
                             with a yellow soft background + bold number so
                             techs can see "3 issues" without reading the row
                             list. (Round-2 feedback.) -->
                        <Border DockPanel.Dock="Right"
                                Background="{StaticResource WarnBgBrush}"
                                CornerRadius="10" Padding="10,3,10,3"
                                VerticalAlignment="Center">
                            <TextBlock Foreground="{StaticResource YellowBrush}"
                                       FontFamily="Segoe UI Semibold" FontSize="{StaticResource FontSize.Mono}">
                                <Run Text="{Binding Findings.Count, Mode=OneWay}" />
                                <Run Text=" issue(s) found" />
                            </TextBlock>
                        </Border>
                        <TextBlock Text="ACTIVE FINDINGS"
                                   FontFamily="Segoe UI Semibold" FontSize="{StaticResource FontSize.Body}"
                                   Foreground="{StaticResource ForegroundBrush}"
                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                    </DockPanel>
                    <!-- v0.5.6 — render the top-10 by severity inline;
                         the remainder lives in the expander below so a
                         long baseline (e.g. 20+ event-viewer warnings)
                         doesn't push the rest of the dashboard off-screen.
                         Both lists share the same row template. -->
                    <ItemsControl ItemsSource="{Binding TopFindings}"
                                  ItemTemplate="{StaticResource FindingRowTemplate}"
                                  Margin="{StaticResource Spacing.Card}" />
                    <Expander Header="{Binding OverflowFindingsCount, StringFormat='{}{0} more findings'}"
                              Margin="16,0,16,8"
                              Foreground="{StaticResource MutedForegroundBrush}"
                              Visibility="{Binding HasOverflowFindings, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding OverflowFindings}"
                                      ItemTemplate="{StaticResource FindingRowTemplate}"
                                      Margin="0,4,0,4" />
                    </Expander>
                </StackPanel>
            </Border>

            <!-- ====== Identity / Pixellot SW (2-up) ======
                 v0.6.5: "Last Diagnostic Run" card dropped — the field tech
                 reported it as empty noise. VM bindings remain dormant so
                 baseline reports / Reports-panel breadcrumbs still work. -->
            <UniformGrid Grid.Row="5" Rows="1" Columns="2" Margin="{StaticResource Spacing.PageLg}">
                <!-- VPU Identity -->
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="VPU IDENTITY" Style="{StaticResource CardCaption}" />
                        <TextBlock Text="{Binding VpuLabel}" Style="{StaticResource SectionTitle}"
                                   FontSize="{StaticResource FontSize.Heading}" TextWrapping="Wrap" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource KvLabel}" Text="Model" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource KvValue}" Text="{Binding VpuModel}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource KvLabel}" Text="Hostname" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource KvValue}" Text="{Binding Hostname}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource KvLabel}" Text="Manufacturer" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource KvValue}" Text="{Binding Manufacturer}" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource KvLabel}" Text="Serial" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource KvValue}" Text="{Binding SerialNumber}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Pixellot Software -->
                <Border Style="{StaticResource Card}" Margin="{StaticResource Spacing.InlineLeft}">
                    <StackPanel>
                        <TextBlock Text="PIXELLOT SOFTWARE" Style="{StaticResource CardCaption}" />
                        <TextBlock Text="{Binding PixellotApp}" Style="{StaticResource SectionTitle}"
                                   FontSize="{StaticResource FontSize.Heading}" />
                        <TextBlock Text="App Version" Style="{StaticResource KvLabel}" Margin="0,2,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource KvLabel}" Text="Image Version" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource KvValue}" Text="{Binding PixellotImage}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource KvLabel}" Text="Dependencies" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource KvValue}" Text="{Binding PixellotDeps}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ====== System Status (gauges) ====== -->
            <Border Grid.Row="6" Style="{StaticResource Card}" Margin="{StaticResource Spacing.PageLg}">
                <StackPanel>
                    <TextBlock Text="SYSTEM STATUS" Style="{StaticResource CardCaption}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- CPU -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center"
                                    AutomationProperties.Name="CPU usage"
                                    AutomationProperties.HelpText="{Binding CpuPctText}">
                            <controls:CircularGauge
                                Percent="{Binding CpuPct}"
                                ValueText="{Binding CpuPctText}"
                                Caption="CPU"
                                ValueBrush="{Binding CpuColor}" />
                            <TextBlock Text="{Binding CpuName}" HorizontalAlignment="Center" FontSize="{StaticResource FontSize.Caption}"
                                       Foreground="{StaticResource SubtleForegroundBrush}"
                                       Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding CpuCoresText}" HorizontalAlignment="Center" FontSize="{StaticResource FontSize.Caption}"
                                       Foreground="{StaticResource SubtleForegroundBrush}" />
                        </StackPanel>

                        <!-- Memory -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center"
                                    AutomationProperties.Name="Memory usage"
                                    AutomationProperties.HelpText="{Binding MemCaption}">
                            <controls:CircularGauge
                                Percent="{Binding MemPct}"
                                ValueText="{Binding MemPctText}"
                                Caption="Memory"
                                ValueBrush="{Binding MemColor}" />
                            <TextBlock Text="{Binding MemCaption}" HorizontalAlignment="Center" FontSize="{StaticResource FontSize.Caption}"
                                       Foreground="{StaticResource SubtleForegroundBrush}"
                                       Margin="0,8,0,0" />
                        </StackPanel>

                        <!-- Disk -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center"
                                    AutomationProperties.Name="System disk usage"
                                    AutomationProperties.HelpText="{Binding DiskCaption}">
                            <controls:CircularGauge
                                Percent="{Binding DiskPct}"
                                ValueText="{Binding DiskPctText}"
                                Caption="System Disk"
                                ValueBrush="{Binding DiskColor}" />
                            <TextBlock Text="{Binding DiskCaption}" HorizontalAlignment="Center" FontSize="{StaticResource FontSize.Caption}"
                                       Foreground="{StaticResource SubtleForegroundBrush}"
                                       Margin="0,8,0,0" />
                        </StackPanel>

                        <!-- v0.6.8 — gauge row reordered per field feedback:
                             Temperature now sits adjacent to the three load
                             gauges (col 3), Uptime (col 4) and Internet (col 5,
                             last) follow. The ring on Uptime/Internet is plain
                             icon+value per the round-2 verdict ("decorative ring").

                             Temperature still uses a ring so it reads as a
                             measurement next to CPU/Memory/Storage. Hidden on
                             machines without ACPI thermal data. -->
                        <StackPanel Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    AutomationProperties.Name="Temperature"
                                    AutomationProperties.HelpText="{Binding TemperatureText}"
                                    Visibility="{Binding TemperatureVisible, Converter={StaticResource BoolToVis}}">
                            <Grid Width="78" Height="78">
                                <Ellipse Width="78" Height="78"
                                         Stroke="{StaticResource BorderColBrush}"
                                         StrokeThickness="6" />
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <md:PackIcon Kind="Thermometer" Width="18" Height="18"
                                                 Foreground="{Binding TemperatureColor}"
                                                 HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding TemperatureText}"
                                               FontFamily="Segoe UI Semibold" FontSize="{StaticResource FontSize.Mono}"
                                               Foreground="{Binding TemperatureColor}"
                                               HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Temperature" HorizontalAlignment="Center" FontSize="{StaticResource FontSize.Caption}"
                                       Foreground="{StaticResource MutedForegroundBrush}" Margin="0,8,0,0" />
                        </StackPanel>

                        <!-- v0.6.8 — Uptime moves to col 4 (was col 3). -->
                        <StackPanel Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    AutomationProperties.Name="Uptime"
                                    AutomationProperties.HelpText="{Binding UptimeText}">
                            <md:PackIcon Kind="ClockOutline" Width="28" Height="28"
                                         Foreground="{StaticResource AccentBrush}"
                                         HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding UptimeText}"
                                       FontFamily="Segoe UI Semibold" FontSize="16"
                                       Foreground="{StaticResource ForegroundBrush}"
                                       HorizontalAlignment="Center" Margin="0,8,0,0" />
                            <TextBlock Text="Uptime" HorizontalAlignment="Center" FontSize="{StaticResource FontSize.Caption}"
                                       Foreground="{StaticResource MutedForegroundBrush}" />
                        </StackPanel>

                        <!-- v0.6.8 — Internet moves to col 5 (last; was col 4). -->
                        <StackPanel Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    AutomationProperties.Name="Internet"
                                    AutomationProperties.HelpText="{Binding InternetText}">
                            <md:PackIcon Kind="Earth" Width="28" Height="28"
                                         Foreground="{Binding InternetColor}"
                                         HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding InternetText}"
                                       FontFamily="Segoe UI Semibold" FontSize="16"
                                       Foreground="{Binding InternetColor}"
                                       HorizontalAlignment="Center" Margin="0,8,0,0" />
                            <TextBlock Text="Internet" HorizontalAlignment="Center" FontSize="{StaticResource FontSize.Caption}"
                                       Foreground="{StaticResource MutedForegroundBrush}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ====== NIC ports + Network config (2-up) ====== -->
            <Grid Grid.Row="7" Margin="{StaticResource Spacing.PageLg}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- NIC Ports -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <md:PackIcon DockPanel.Dock="Left" Kind="EthernetCable"
                                         Width="18" Height="18"
                                         Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="NIC PORTS"
                                       FontFamily="Segoe UI Semibold" FontSize="{StaticResource FontSize.Small}"
                                       Foreground="{StaticResource MutedForegroundBrush}"
                                       Margin="{StaticResource Spacing.InlineLeftLg}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding NicPorts}"
                                      ItemTemplate="{StaticResource NicPortRowTemplate}"
                                      Margin="{StaticResource Spacing.Card}" />
                    </StackPanel>
                </Border>

                <!-- Network Config -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <md:PackIcon DockPanel.Dock="Left" Kind="Lan"
                                         Width="18" Height="18"
                                         Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="NETWORK"
                                       FontFamily="Segoe UI Semibold" FontSize="{StaticResource FontSize.Small}"
                                       Foreground="{StaticResource MutedForegroundBrush}"
                                       Margin="{StaticResource Spacing.InlineLeftLg}" VerticalAlignment="Center" />
                        </DockPanel>
                        <!-- Network Configuration grid: each value row gets a small
                             status dot in column 0 — green when populated, muted
                             when blank/em-dash. Lets a non-tech read the row at a
                             glance without needing to know what NTP / DNS mean.
                             (UX review rec #5.) -->
                        <Grid Margin="{StaticResource Spacing.Card}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Uplink: no dot — informational -->
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource KvLabel}" Text="Uplink Adapter" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource KvValue}" Text="{Binding UplinkAdapter}" />

                            <Ellipse Grid.Row="1" Grid.Column="0" Width="8" Height="8" Margin="0,2,0,2"
                                     VerticalAlignment="Center" HorizontalAlignment="Left"
                                     Fill="{Binding IpDotColor}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource KvLabel}" Text="IP Address" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource KvValue}"
                                       FontFamily="Consolas" Text="{Binding IpAddress}" />

                            <Ellipse Grid.Row="2" Grid.Column="0" Width="8" Height="8" Margin="0,2,0,2"
                                     VerticalAlignment="Center" HorizontalAlignment="Left"
                                     Fill="{Binding GatewayDotColor}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource KvLabel}" Text="Gateway" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource KvValue}"
                                       FontFamily="Consolas" Text="{Binding Gateway}" />

                            <Ellipse Grid.Row="3" Grid.Column="0" Width="8" Height="8" Margin="0,2,0,2"
                                     VerticalAlignment="Center" HorizontalAlignment="Left"
                                     Fill="{Binding DnsDotColor}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource KvLabel}" Text="DNS Servers" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource KvValue}"
                                       FontFamily="Consolas" Text="{Binding DnsServers}" />

                            <Ellipse Grid.Row="4" Grid.Column="0" Width="8" Height="8" Margin="0,2,0,2"
                                     VerticalAlignment="Center" HorizontalAlignment="Left"
                                     Fill="{Binding NtpDotColor}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource KvLabel}" Text="NTP Server" />
                            <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource KvValue}"
                                       FontFamily="Consolas" Text="{Binding NtpServer}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ====== Storage + Pixellot Services (2-up) ====== -->
            <Grid Grid.Row="8" Margin="{StaticResource Spacing.PageLg}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Storage -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <md:PackIcon DockPanel.Dock="Left" Kind="Harddisk"
                                         Width="18" Height="18"
                                         Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="STORAGE"
                                       FontFamily="Segoe UI Semibold" FontSize="{StaticResource FontSize.Small}"
                                       Foreground="{StaticResource MutedForegroundBrush}"
                                       Margin="{StaticResource Spacing.InlineLeftLg}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Volumes}"
                                      ItemTemplate="{StaticResource VolumeRowTemplate}"
                                      Margin="{StaticResource Spacing.Card}" />
                    </StackPanel>
                </Border>

                <!-- Pixellot Services -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <md:PackIcon DockPanel.Dock="Left" Kind="ServerNetwork"
                                         Width="18" Height="18"
                                         Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="PIXELLOT SERVICES"
                                       FontFamily="Segoe UI Semibold" FontSize="{StaticResource FontSize.Small}"
                                       Foreground="{StaticResource MutedForegroundBrush}"
                                       Margin="{StaticResource Spacing.InlineLeftLg}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Services}"
                                      ItemTemplate="{StaticResource ServiceRowTemplate}"
                                      Margin="{StaticResource Spacing.Card}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ====== Quick Nav (hub tiles) — bottom row ======
                 Refresh button moved to the page header. Caption kept above
                 the tiles so the section is still labelled. -->
            <Border Grid.Row="9" Style="{StaticResource Card}" Padding="16,12,16,12" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="QUICK NAV"
                               FontFamily="Segoe UI Semibold" FontSize="{StaticResource FontSize.Small}"
                               Foreground="{StaticResource MutedForegroundBrush}"
                               Margin="0,0,0,12" />
                    <!-- Compact single-row Quick Nav. Description text is gone —
                         the title alone is enough since the user already knows
                         the panel set. WrapPanel still flows to a second row at
                         narrower window widths. -->
                    <ItemsControl ItemsSource="{Binding Tiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Tile bindings: see comment in v0.2.0 fix above —
                                     NavigateCommand binds to the parent VM via
                                     RelativeSource, TargetNav passes through as the
                                     command parameter. -->
                                <!-- Width bumped from 160 → 220 so the longer
                                     titles ("Network Configuration",
                                     "System & Disk Health") render in full.
                                     WrapPanel still
                                     flows to a second row below 1200 px. -->
                                <Button Style="{StaticResource HubTile}"
                                        Command="{Binding DataContext.NavigateCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding TargetNav}"
                                        Width="220" Height="44"
                                        Padding="14,0,14,0"
                                        Margin="0,0,8,8"
                                        HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <md:PackIcon Kind="{Binding IconKind}" Width="16" Height="16"
                                                     Foreground="{StaticResource AccentBrush}"
                                                     VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Title}"
                                                   FontFamily="Segoe UI Semibold" FontSize="{StaticResource FontSize.Body}"
                                                   Foreground="{StaticResource ForegroundBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="{StaticResource Spacing.InlineLeftLg}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
