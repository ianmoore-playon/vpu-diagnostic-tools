<UserControl x:Class="Pulse.WPF.Views.ScoreConnectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Pulse.WPF.ViewModels"
             xmlns:controls="clr-namespace:Pulse.WPF.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:ScoreConnectViewModel, IsDesignTimeCreatable=False}"
             mc:Ignorable="d"
             Background="{StaticResource AppBgBrush}">

    <UserControl.Resources>
        <Style x:Key="NetSubCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,12,14,12" />
        </Style>
        <Style x:Key="NetSubHeading" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,24,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- Header -->
                <RowDefinition Height="Auto" />   <!-- Findings -->
                <RowDefinition Height="Auto" />   <!-- Recommendations -->
                <RowDefinition Height="Auto" />   <!-- Service + Live row -->
                <RowDefinition Height="Auto" />   <!-- Configuration card -->
                <RowDefinition Height="Auto" />   <!-- BOT + Ports row -->
                <RowDefinition Height="*" MinHeight="200" /> <!-- Live Log -->
            </Grid.RowDefinitions>

            <!-- ===== Header ===== -->
            <DockPanel Grid.Row="0" Margin="0,0,0,24">
                <Border DockPanel.Dock="Right" Style="{StaticResource StatusChip}"
                        Background="{Binding StatusBg}" Margin="8,0,0,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="9" Height="9" Fill="{Binding StatusColor}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold"
                                   Foreground="{Binding StatusColor}"
                                   Margin="{StaticResource Spacing.InlineLeft}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding OpenScoreConnectGuiCommand}"
                            Style="{StaticResource TopBarPrimaryButton}"
                            Margin="0,0,8,0"
                            ToolTip="Open the ScoreConnect III web GUI in your default browser.">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <md:PackIcon Kind="OpenInNew" Width="16" Height="16" VerticalAlignment="Center"
                                         Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="Open ScoreConnect GUI" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RefreshCommand}"
                            Style="{StaticResource TopBarPrimaryButton}"
                            ToolTip="Re-probe the ScoreConnect III service and refresh all cards.">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <md:PackIcon Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center"
                                         Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="Refresh" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Score Connect" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="ScoreConnect III scoreboard integration — service, configuration, cloud control, and live data"
                               Style="{StaticResource PageSubtitle}"
                               TextTrimming="CharacterEllipsis" MaxWidth="720" />
                </StackPanel>
            </DockPanel>

            <!-- ===== Findings banner ===== -->
            <controls:FindingsBanner Grid.Row="1"
                                     Findings="{Binding Findings}"
                                     Margin="{StaticResource Spacing.Page}" />

            <!-- ===== Recommended Actions ===== -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="{StaticResource Spacing.Page}"
                    Visibility="{Binding Recommendations.Count, Converter={StaticResource CountToVis}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <md:PackIcon DockPanel.Dock="Left" Kind="AlertCircleOutline"
                                     Width="20" Height="20"
                                     Foreground="{StaticResource YellowBrush}"
                                     VerticalAlignment="Center" />
                        <TextBlock Text="Recommended Actions" Style="{StaticResource SectionTitle}"
                                   Margin="{StaticResource Spacing.InlineLeftLg}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Recommendations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding SeverityBg}"
                                        CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{Binding SeverityColor}"
                                                    CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Severity}" Foreground="White"
                                                           FontWeight="SemiBold"
                                                           FontSize="{StaticResource FontSize.Caption}" />
                                            </Border>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource ForegroundBrush}"
                                                       Margin="{StaticResource Spacing.InlineLeft}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Body}"
                                                   Foreground="{StaticResource ForegroundBrush}"
                                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                                        <Button Content="{Binding ActionLabel}"
                                                Command="{Binding ActionCommand}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                HorizontalAlignment="Left" Margin="0,8,0,0"
                                                MinWidth="140"
                                                Visibility="{Binding ActionLabel, Converter={StaticResource StringToVis}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== Service status + Live scoreboard ===== -->
            <Grid Grid.Row="3" Margin="{StaticResource Spacing.Page}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Service status -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Service Status" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Detected:" Style="{StaticResource MutedLabel}" />
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{Binding Status.IsDetected}" Style="{StaticResource MonoValue}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Base URL:"
                                       Style="{StaticResource MutedLabel}" Margin="{StaticResource Spacing.RowGap}" />
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{Binding Status.BaseUrl}" Style="{StaticResource MonoValue}"
                                       Margin="{StaticResource Spacing.RowGap}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Version:"
                                       Style="{StaticResource MutedLabel}" Margin="{StaticResource Spacing.RowGap}" />
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Text="{Binding Status.Version, FallbackValue=—}"
                                       Style="{StaticResource MonoValue}" Margin="{StaticResource Spacing.RowGap}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Last probe:"
                                       Style="{StaticResource MutedLabel}" Margin="{StaticResource Spacing.RowGap}" />
                            <TextBlock Grid.Row="3" Grid.Column="1"
                                       Text="{Binding LastProbedAtDisplay}"
                                       Style="{StaticResource MonoValue}" Margin="{StaticResource Spacing.RowGap}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Last error:"
                                       Style="{StaticResource MutedLabel}"
                                       Margin="{StaticResource Spacing.RowGap}"
                                       Visibility="{Binding HasProbeError, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Grid.Row="4" Grid.Column="1"
                                       Text="{Binding Status.ProbeError}"
                                       Foreground="{StaticResource RedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="{StaticResource Spacing.RowGap}"
                                       Visibility="{Binding HasProbeError, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Live scoreboard -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <Border DockPanel.Dock="Right" CornerRadius="3" Padding="6,2"
                                    Background="{StaticResource BorderColBrush}"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding LiveConnected, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                <TextBlock Text="OFFLINE"
                                           Foreground="{StaticResource MutedForegroundBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="{StaticResource FontSize.Caption}" />
                            </Border>
                            <Border DockPanel.Dock="Right" CornerRadius="3" Padding="6,2"
                                    Background="{StaticResource GreenBrush}"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding LiveConnected, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="LIVE" Foreground="White" FontWeight="SemiBold"
                                           FontSize="{StaticResource FontSize.Caption}" />
                            </Border>
                            <TextBlock Text="Live Scoreboard" Style="{StaticResource SectionTitle}"
                                       Margin="0" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{Binding LiveFeedDetail}"
                                   Foreground="{StaticResource MutedForegroundBrush}"
                                   FontSize="{StaticResource FontSize.Caption}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding LiveFeedLogPath}"
                                   Margin="0,-4,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- U1 fix: drop FallbackValue=0 on Home/Away score
                                 TextBlocks. With no LiveScoreData attached the
                                 40-pt bold "0" rendered exactly like a real
                                 stuck game at 0-0. Now the score TextBlocks
                                 are gated on LiveScoreData being non-null;
                                 when there's no live feed the card shows the
                                 team-name row with an em-dash and the score
                                 area collapses to keep the column heights
                                 stable. -->
                            <Border Grid.Column="0" Style="{StaticResource NetSubCard}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="HOME" Style="{StaticResource NetSubHeading}" />
                                    <TextBlock Text="{Binding LiveScoreData.HomeTeam, FallbackValue=—}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource ForegroundBrush}" />
                                    <TextBlock Text="{Binding LiveScoreData.HomeScore}"
                                               Visibility="{Binding LiveScoreData, Converter={StaticResource NullToVis}}"
                                               FontSize="40" FontWeight="Bold"
                                               Foreground="{StaticResource ForegroundBrush}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource NetSubCard}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="AWAY" Style="{StaticResource NetSubHeading}" />
                                    <TextBlock Text="{Binding LiveScoreData.AwayTeam, FallbackValue=—}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource ForegroundBrush}" />
                                    <TextBlock Text="{Binding LiveScoreData.AwayScore}"
                                               Visibility="{Binding LiveScoreData, Converter={StaticResource NullToVis}}"
                                               FontSize="40" FontWeight="Bold"
                                               Foreground="{StaticResource ForegroundBrush}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Period" Style="{StaticResource MutedLabel}" />
                                <TextBlock Text="{Binding LiveScoreData.Period, FallbackValue=—}"
                                           Style="{StaticResource MonoValue}" FontSize="16" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Clock" Style="{StaticResource MutedLabel}" />
                                <TextBlock Text="{Binding LiveScoreData.Clock, FallbackValue=—}"
                                           Style="{StaticResource MonoValue}" FontSize="16" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Updated" Style="{StaticResource MutedLabel}" />
                                <TextBlock Text="{Binding LiveScoreData.LastUpdatedAt, FallbackValue=—,
                                                  StringFormat=HH:mm:ss}"
                                           Style="{StaticResource MonoValue}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== Connected device / configuration ===== -->
            <Border Grid.Row="4" Style="{StaticResource Card}" Margin="{StaticResource Spacing.Page}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock DockPanel.Dock="Left" Text="Connected Device"
                                   Style="{StaticResource SectionTitle}" />
                    </DockPanel>

                    <!-- Empty state -->
                    <TextBlock Text="No scoreboard configured. Click \&quot;Open ScoreConnect GUI\&quot; above to choose a vendor + sport."
                               Foreground="{StaticResource MutedForegroundBrush}" TextWrapping="Wrap"
                               Visibility="{Binding HasConfiguration, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

                    <Grid Visibility="{Binding HasConfiguration, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left column -->
                        <Border Grid.Column="0" Style="{StaticResource NetSubCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Vendor:" Style="{StaticResource MutedLabel}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Configuration.Vendor}"
                                           Style="{StaticResource MonoValue}" />
                                <Button   Grid.Row="0" Grid.Column="2"
                                          Command="{Binding EditVendorCommand}"
                                          ToolTip="Change the vendor."
                                          Style="{StaticResource MaterialDesignFlatButton}">
                                    <md:PackIcon Kind="Pencil" Width="14" Height="14" />
                                </Button>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Sport:"
                                           Style="{StaticResource MutedLabel}" Margin="{StaticResource Spacing.RowGap}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Configuration.Sport}"
                                           Style="{StaticResource MonoValue}" Margin="{StaticResource Spacing.RowGap}" />
                                <Button   Grid.Row="1" Grid.Column="2"
                                          Command="{Binding EditSportCommand}"
                                          ToolTip="Change the sport."
                                          Style="{StaticResource MaterialDesignFlatButton}">
                                    <md:PackIcon Kind="Pencil" Width="14" Height="14" />
                                </Button>

                                <!-- v0.6.1: the third row now labels itself
                                     "Configuration" and binds to the human-
                                     readable name of the vendor configuration
                                     (e.g. "Wired") — the typed Device field on
                                     the response is rarely populated, and the
                                     EditConfigurationCommand actually edits
                                     the vendor configuration, not a device.
                                     The earlier "Device:" label was misleading. -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Configuration:"
                                           Style="{StaticResource MutedLabel}" Margin="{StaticResource Spacing.RowGap}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Configuration.VendorConfigurationName}"
                                           Style="{StaticResource MonoValue}" Margin="{StaticResource Spacing.RowGap}" />
                                <Button   Grid.Row="2" Grid.Column="2"
                                          Command="{Binding EditConfigurationCommand}"
                                          ToolTip="Change the vendor configuration."
                                          Style="{StaticResource MaterialDesignFlatButton}">
                                    <md:PackIcon Kind="Pencil" Width="14" Height="14" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Right column -->
                        <Border Grid.Column="2" Style="{StaticResource NetSubCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Serial port:"
                                           Style="{StaticResource MutedLabel}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Configuration.SerialPort}"
                                           Style="{StaticResource MonoValue}" />
                                <Button   Grid.Row="0" Grid.Column="2"
                                          Command="{Binding EditDecoderCommand}"
                                          ToolTip="Change the serial port / decoder."
                                          Style="{StaticResource MaterialDesignFlatButton}">
                                    <md:PackIcon Kind="Pencil" Width="14" Height="14" />
                                </Button>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Firmware:"
                                           Style="{StaticResource MutedLabel}" Margin="{StaticResource Spacing.RowGap}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Configuration.Firmware}"
                                           Style="{StaticResource MonoValue}" Margin="{StaticResource Spacing.RowGap}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Event type:"
                                           Style="{StaticResource MutedLabel}" Margin="{StaticResource Spacing.RowGap}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Configuration.EventType}"
                                           Style="{StaticResource MonoValue}" Margin="{StaticResource Spacing.RowGap}" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Extended-fields table — only shown when the response carried unknown keys -->
                    <Border Margin="0,12,0,0" Style="{StaticResource NetSubCard}"
                            Visibility="{Binding ConfigurationExtraRows.Count, Converter={StaticResource CountToVis}}">
                        <StackPanel>
                            <TextBlock Text="EXTENDED FIELDS" Style="{StaticResource NetSubHeading}" />
                            <ItemsControl ItemsSource="{Binding ConfigurationExtraRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Key}"
                                                       Style="{StaticResource MutedLabel}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                       Style="{StaticResource MonoValue}"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== Cloud (BOT) status + Available ports ===== -->
            <Grid Grid.Row="5" Margin="{StaticResource Spacing.Page}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Cloud BOT -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Cloud (BOT) Status" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Connected:" Style="{StaticResource MutedLabel}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding BotStatus.IsConnected}"
                                       Style="{StaticResource MonoValue}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="ScoreConnect ID:"
                                       Style="{StaticResource MutedLabel}" Margin="{StaticResource Spacing.RowGap}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BotStatus.ScoreConnectId, FallbackValue=—}"
                                       Style="{StaticResource MonoValue}" Margin="{StaticResource Spacing.RowGap}"
                                       TextTrimming="CharacterEllipsis" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="BOT server:"
                                       Style="{StaticResource MutedLabel}" Margin="{StaticResource Spacing.RowGap}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BotStatus.BotServerAddress, FallbackValue=—}"
                                       Style="{StaticResource MonoValue}" Margin="{StaticResource Spacing.RowGap}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Last error:"
                                       Style="{StaticResource MutedLabel}" Margin="{StaticResource Spacing.RowGap}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding BotStatus.LastErrorMessage, FallbackValue=—}"
                                       Foreground="{StaticResource MutedForegroundBrush}"
                                       TextWrapping="Wrap" Margin="{StaticResource Spacing.RowGap}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Available serial ports -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Available Serial Ports" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                        <TextBlock Text="No serial ports reported by ScoreConnect III."
                                   Foreground="{StaticResource MutedForegroundBrush}"
                                   Visibility="{Binding AvailablePorts.Count, Converter={StaticResource CountToVis}, ConverterParameter=Invert}" />
                        <ItemsControl ItemsSource="{Binding AvailablePorts}"
                                      Visibility="{Binding AvailablePorts.Count, Converter={StaticResource CountToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource AppBgBrush}"
                                            BorderBrush="{StaticResource BorderColBrush}" BorderThickness="1"
                                            CornerRadius="6" Margin="0,0,0,6" Padding="12,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource ForegroundBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding OwningVendor}"
                                                       Style="{StaticResource MutedLabel}"
                                                       VerticalAlignment="Center" />
                                            <Border Grid.Column="2" CornerRadius="3" Padding="6,1"
                                                    Background="{StaticResource YellowBrush}"
                                                    Visibility="{Binding IsInUse, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="IN USE" Foreground="White" FontWeight="SemiBold"
                                                           FontSize="{StaticResource FontSize.Caption}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== Live Log ===== -->
            <Border Grid.Row="6" Style="{StaticResource Card}" Margin="{StaticResource Spacing.Page}">
                <StackPanel>
                    <TextBlock Text="Live Log" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding LogEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                                               Foreground="{StaticResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Result}"
                                               Foreground="{Binding ResultColor}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
