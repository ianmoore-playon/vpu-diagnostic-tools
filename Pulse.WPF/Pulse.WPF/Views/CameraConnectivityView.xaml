<UserControl x:Class="Pulse.WPF.Views.CameraConnectivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Pulse.WPF.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:CameraConnectivityViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource AppBgBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,24,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- Section header -->
                <RowDefinition Height="Auto" />   <!-- Toolbar row -->
                <RowDefinition Height="Auto" />   <!-- Port cards (responsive WrapPanel) -->
                <RowDefinition Height="Auto" />   <!-- Status cards row -->
                <RowDefinition Height="*"    MinHeight="280" />  <!-- Log + Guidance -->
                <RowDefinition Height="Auto" />   <!-- Action bar -->
            </Grid.RowDefinitions>

            <!-- ====== Section header ====== -->
            <DockPanel Grid.Row="0" Margin="0,0,0,24">
                <Border DockPanel.Dock="Right" Style="{StaticResource StatusChip}"
                        Background="{Binding StatusBg}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Fill="{Binding StatusColor}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold"
                                   Foreground="{Binding StatusColor}" Margin="8,0,0,0" />
                    </StackPanel>
                </Border>
                <StackPanel>
                    <TextBlock Text="Camera Connectivity" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Validate link speed, ping cameras, and isolate physical-layer faults"
                               Style="{StaticResource PageSubtitle}" />
                </StackPanel>
            </DockPanel>

            <!-- ====== Toolbar: Test Scope + Detected NIC ====== -->
            <Grid Grid.Row="1" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0"
                          Width="380"
                          Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                          md:HintAssist.Hint="Test Scope"
                          ItemsSource="{Binding TestScopes}"
                          SelectedItem="{Binding SelectedScope}" />
                <TextBlock Grid.Column="2"
                           Text="{Binding DetectedNic}"
                           Foreground="{StaticResource MutedForegroundBrush}"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- ====== Port detail cards — responsive WrapPanel ====== -->
            <ItemsControl Grid.Row="2" ItemsSource="{Binding Ports}" Margin="0,0,0,16">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}"
                                Width="296" Height="178"
                                Margin="0,0,12,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Card header: Port N + status pill -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding Name}" FontFamily="Segoe UI Semibold"
                                               FontSize="15" Foreground="{StaticResource ForegroundBrush}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Ellipse Width="10" Height="10" Fill="{Binding StatusColor}"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}"
                                                   FontWeight="SemiBold" Margin="8,0,0,0" />
                                    </StackPanel>
                                </DockPanel>

                                <!-- Body grid: 5 key/value rows -->
                                <Grid Grid.Row="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Device:"
                                               Style="{StaticResource MutedLabel}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Text="{Binding Device}" Foreground="{Binding DeviceColor}"
                                               FontWeight="SemiBold" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Speed:"
                                               Style="{StaticResource MutedLabel}" Margin="0,4,0,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                               Text="{Binding Speed}" Margin="0,4,0,0" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="IP:"
                                               Style="{StaticResource MutedLabel}" Margin="0,4,0,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Ip}"
                                               Style="{StaticResource MonoValue}" Margin="0,4,0,0" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="MAC:"
                                               Style="{StaticResource MutedLabel}" Margin="0,4,0,0" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Mac}"
                                               Style="{StaticResource MonoValue}" Margin="0,4,0,0" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Errors:"
                                               Style="{StaticResource MutedLabel}" Margin="0,4,0,0" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Errors}"
                                               Foreground="{Binding ErrorsColor}" Margin="0,4,0,0" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ====== Status cards row (5 placeholder cards) ====== -->
            <Grid Grid.Row="3" Margin="0,8,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="SmartSpeed" Style="{StaticResource MutedLabel}" />
                        <TextBlock Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <TextBlock Text="Intel events (48h)" Style="{StaticResource MutedLabel}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,6,0">
                    <StackPanel>
                        <TextBlock Text="Ping (CHU)" Style="{StaticResource MutedLabel}" />
                        <TextBlock Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <TextBlock Text="ICMP reachability" Style="{StaticResource MutedLabel}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="6,0,6,0">
                    <StackPanel>
                        <TextBlock Text="ARP Entry" Style="{StaticResource MutedLabel}" />
                        <TextBlock Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <TextBlock Text="L2 neighbour table" Style="{StaticResource MutedLabel}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource Card}" Margin="6,0,6,0">
                    <StackPanel>
                        <TextBlock Text="CHU Detection" Style="{StaticResource MutedLabel}" />
                        <TextBlock Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <TextBlock Text="RTSP port 554" Style="{StaticResource MutedLabel}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource Card}" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="PoE Budget" Style="{StaticResource MutedLabel}" />
                        <TextBlock Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <TextBlock Text="ADLINK SmartPoE" Style="{StaticResource MutedLabel}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ====== Log + Guidance two-column area ====== -->
            <Grid Grid.Row="4" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" MinWidth="280" />
                </Grid.ColumnDefinitions>

                <!-- Live Log -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Live Log" Style="{StaticResource SectionTitle}"
                                   Margin="0,0,0,12" />
                        <Border BorderBrush="{StaticResource BorderColBrush}" BorderThickness="0,1,0,0"
                                Background="{StaticResource LogBgBrush}" CornerRadius="6">
                            <ListBox ItemsSource="{Binding LogEntries}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     FontFamily="Cascadia Mono, Consolas"
                                     FontSize="11">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="8,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                       Foreground="{StaticResource MutedForegroundBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Result}"
                                                       Foreground="{Binding ResultColor}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- Guidance -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Next Steps Guidance" Style="{StaticResource SectionTitle}"
                                   Margin="0,0,0,12" />
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedForegroundBrush}"
                                   Text="Live port-status monitoring is active. Plug or unplug a camera and the port cards above update automatically — no need to re-run the test.&#x0a;&#x0a;Run Test refreshes the cards and clears any cached state. The full diagnostic engine port (port-speed remediation, RTSP, SmartSpeed, PoE) is deferred past the pilot."
                                   Margin="0,0,0,16" />
                        <Button Content="Open Fault Isolator →"
                                Command="{Binding OpenFaultIsolatorCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                        <Button Content="Open Adapter Settings"
                                Command="{Binding OpenAdapterSettingsCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ====== Bottom action bar ====== -->
            <DockPanel Grid.Row="5">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Export Report"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            IsEnabled="False" />
                    <Button Content="Copy Summary" Margin="8,0,0,0"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            IsEnabled="False" />
                    <Button Content="Save Log" Margin="8,0,0,0"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            IsEnabled="False" />
                </StackPanel>
                <Button DockPanel.Dock="Right"
                        Command="{Binding RunTestCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Padding="22,10" FontWeight="SemiBold">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Play" Width="18" Height="18" VerticalAlignment="Center" />
                        <TextBlock Text="Run Test" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
