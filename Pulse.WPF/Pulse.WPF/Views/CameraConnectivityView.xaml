<UserControl x:Class="Pulse.WPF.Views.CameraConnectivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Pulse.WPF.ViewModels"
             xmlns:controls="clr-namespace:Pulse.WPF.Controls"
             d:DataContext="{d:DesignInstance Type=vm:CameraConnectivityViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource AppBgBrush}">

    <UserControl.Resources>
        <!-- Local sub-card style used for each port tile in the diagram strip.
             Mirrors NetSubCard from NetworkView so the two pages feel like
             siblings; the only difference is a slightly stronger corner
             radius to read as a "device" rather than a sub-section. -->
        <Style x:Key="CcSubCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,12,14,12" />
        </Style>

        <Style x:Key="CcSubHeading" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <!-- Right-click "Copy" context menu reused on IP and MAC mono cells. -->
        <ContextMenu x:Key="CopyOnlyMenu">
            <MenuItem Header="Copy"
                      Command="ApplicationCommands.Copy" />
        </ContextMenu>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,24,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- 0: Section header -->
                <RowDefinition Height="Auto" />   <!-- 1: Findings banner -->
                <RowDefinition Height="Auto" />   <!-- 2: Recommended Actions -->
                <RowDefinition Height="Auto" />   <!-- 3: NIC diagram strip (4 tiles) -->
                <RowDefinition Height="Auto" />   <!-- 4: Live Log expander -->
                <RowDefinition Height="Auto" />   <!-- 5: Action bar -->
            </Grid.RowDefinitions>

            <!-- ====== Section header ====== -->
            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <Border DockPanel.Dock="Right" Style="{StaticResource StatusChip}"
                        Background="{Binding StatusBg}"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Overall panel status"
                        AutomationProperties.HelpText="{Binding StatusLabel}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="9" Height="9" Fill="{Binding StatusColor}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold"
                                   Foreground="{Binding StatusColor}" Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <StackPanel>
                    <TextBlock Text="Camera Connectivity" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Live diagram of the 4 camera-NIC ports — link state, role, errors, history"
                               Style="{StaticResource PageSubtitle}" />
                </StackPanel>
            </DockPanel>

            <!-- ====== Findings banner — auto-collapses when empty ====== -->
            <controls:FindingsBanner Grid.Row="1"
                                     Margin="0,0,0,16"
                                     Findings="{Binding Findings}"
                                     AutomationProperties.Name="Findings summary" />

            <!-- ====== Recommended Actions (auto-collapse) ====== -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,16"
                    Visibility="{Binding Recommendations.Count, Converter={StaticResource CountToVis}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <md:PackIcon DockPanel.Dock="Left" Kind="AlertCircleOutline"
                                     Width="20" Height="20"
                                     Foreground="{StaticResource YellowBrush}"
                                     VerticalAlignment="Center" />
                        <TextBlock Text="Recommended Actions" Style="{StaticResource SectionTitle}"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Recommendations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding SeverityBg}"
                                        CornerRadius="6"
                                        Padding="12,10"
                                        Margin="0,0,0,8">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{Binding SeverityColor}"
                                                    CornerRadius="3" Padding="6,1"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Severity}"
                                                           Foreground="White"
                                                           FontWeight="SemiBold" FontSize="10" />
                                            </Border>
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource ForegroundBrush}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Body}"
                                                   Foreground="{StaticResource ForegroundBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0" />
                                        <!-- Inline action button — only visible when ActionCommand is set. -->
                                        <Button Content="{Binding ActionLabel}"
                                                Command="{Binding ActionCommand}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                HorizontalAlignment="Left"
                                                Margin="0,8,0,0"
                                                MinWidth="160" MinHeight="32"
                                                Visibility="{Binding ActionLabel, Converter={StaticResource StringToVis}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ====== NIC diagram strip — always shows all 4 tiles ====== -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <md:PackIcon DockPanel.Dock="Left" Kind="LanConnect"
                                     Width="20" Height="20"
                                     Foreground="{StaticResource AccentBrush}"
                                     VerticalAlignment="Center" />
                        <TextBlock Text="{Binding NicCaption}"
                                   Style="{StaticResource SectionTitle}"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- v0.4.6: NIC card diagram sits inside the *same* Card so
                         its 4-column UniformGrid lines up exactly with the
                         tile UniformGrid below. Each jack's LED reads the
                         corresponding PortViewModel.LinkLedBrush. -->
                    <controls:NicCardDiagram Ports="{Binding Ports}"
                                             AutomationProperties.Name="Camera NIC card schematic" />

                    <!-- Fixed 4 * grid: every tile is always visible. ItemsControl
                         is replaced by a hand-rolled 4-column Grid because the
                         binding count is locked to 4 and we never want to wrap. -->
                    <ItemsControl ItemsSource="{Binding Ports}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CcSubCard}" Margin="0,0,12,0"
                                        Opacity="{Binding TileOpacity}"
                                        AutomationProperties.Name="{Binding Name}"
                                        AutomationProperties.HelpText="{Binding StatusLine}">
                                    <StackPanel>
                                        <!-- Header: port-number badge + Port N + status dot.
                                             v0.4.6 — the Ethernet PackIcon was removed
                                             because the jacks now live in the diagram
                                             above; a small port-number badge keeps the
                                             tile↔jack mapping unambiguous when scrolled. -->
                                        <DockPanel Margin="0,0,0,10">
                                            <Border DockPanel.Dock="Left"
                                                    CornerRadius="4"
                                                    Padding="6,1"
                                                    Background="{StaticResource SurfaceBgBrush}"
                                                    BorderBrush="{StaticResource BorderColBrush}"
                                                    BorderThickness="1"
                                                    VerticalAlignment="Center">
                                                <TextBlock FontFamily="Segoe UI Semibold"
                                                           FontSize="11"
                                                           Foreground="{StaticResource MutedForegroundBrush}">
                                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                                </TextBlock>
                                            </Border>
                                            <Ellipse DockPanel.Dock="Right"
                                                     Width="10" Height="10"
                                                     Fill="{Binding StatusColor}"
                                                     VerticalAlignment="Center"
                                                     ToolTip="{Binding StatusLine}" />
                                        </DockPanel>

                                        <!-- Primary device label.
                                             Foreground binds straight to PrimaryColor (no inline
                                             {StaticResource} FallbackValue — that's an invalid
                                             nested markup-extension that crashed the tab on load
                                             in v0.4.6). VM defaults PrimaryColor to ForegroundBrush. -->
                                        <TextBlock Text="{Binding PrimaryLabel}"
                                                   FontFamily="Segoe UI Semibold"
                                                   FontSize="14"
                                                   Foreground="{Binding PrimaryColor}"
                                                   TextTrimming="CharacterEllipsis" />

                                        <!-- Secondary muted label -->
                                        <TextBlock Text="{Binding SecondaryLabel}"
                                                   Foreground="{StaticResource MutedForegroundBrush}"
                                                   FontSize="11"
                                                   Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding SecondaryLabel, Converter={StaticResource StringToVis}}" />

                                        <!-- Status / speed line -->
                                        <TextBlock Text="{Binding StatusLine}"
                                                   Foreground="{Binding StatusColor}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,8,0,0"
                                                   TextWrapping="Wrap" />

                                        <!-- IP / MAC mono pair -->
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="IP"
                                                       Style="{StaticResource MutedLabel}" />
                                            <TextBox  Grid.Row="0" Grid.Column="1"
                                                      Text="{Binding Ip, Mode=OneWay}"
                                                      IsReadOnly="True"
                                                      BorderThickness="0"
                                                      Background="Transparent"
                                                      Foreground="{StaticResource ForegroundBrush}"
                                                      FontFamily="Cascadia Mono, Consolas"
                                                      FontSize="11"
                                                      Padding="0"
                                                      ContextMenu="{StaticResource CopyOnlyMenu}" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="MAC"
                                                       Style="{StaticResource MutedLabel}" Margin="0,4,0,0" />
                                            <TextBox  Grid.Row="1" Grid.Column="1"
                                                      Text="{Binding Mac, Mode=OneWay}"
                                                      IsReadOnly="True"
                                                      BorderThickness="0"
                                                      Background="Transparent"
                                                      Foreground="{StaticResource ForegroundBrush}"
                                                      FontFamily="Cascadia Mono, Consolas"
                                                      FontSize="11"
                                                      Padding="0"
                                                      Margin="0,4,0,0"
                                                      ContextMenu="{StaticResource CopyOnlyMenu}" />
                                        </Grid>

                                        <!-- Error line -->
                                        <TextBlock Text="{Binding ErrorLine}"
                                                   Foreground="{Binding ErrorColor}"
                                                   Margin="0,8,0,0"
                                                   FontSize="11"
                                                   Visibility="{Binding ErrorLine, Converter={StaticResource StringToVis}}" />

                                        <!-- Duration / Last-seen -->
                                        <TextBlock Text="{Binding DurationText}"
                                                   Foreground="{StaticResource MutedForegroundBrush}"
                                                   Margin="0,4,0,0"
                                                   FontSize="11"
                                                   Visibility="{Binding DurationText, Converter={StaticResource StringToVis}}" />

                                        <!-- Recent activity expander (collapsed by default) -->
                                        <Expander Header="Recent activity"
                                                  Margin="0,10,0,0"
                                                  Foreground="{StaticResource MutedForegroundBrush}"
                                                  FontSize="11"
                                                  Visibility="{Binding History.Count, Converter={StaticResource CountToVis}}">
                                            <ItemsControl ItemsSource="{Binding History}"
                                                          MaxHeight="160">
                                                <ItemsControl.Template>
                                                    <ControlTemplate TargetType="ItemsControl">
                                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                                      HorizontalScrollBarVisibility="Disabled">
                                                            <ItemsPresenter />
                                                        </ScrollViewer>
                                                    </ControlTemplate>
                                                </ItemsControl.Template>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2,0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="60" />
                                                                <ColumnDefinition Width="64" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding TimestampLabel}"
                                                                       FontFamily="Cascadia Mono, Consolas"
                                                                       FontSize="10"
                                                                       Foreground="{StaticResource MutedForegroundBrush}" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding State}"
                                                                       Foreground="{Binding StateColor}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="10" />
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding Note}"
                                                                       Foreground="{StaticResource ForegroundBrush}"
                                                                       FontSize="10"
                                                                       TextWrapping="Wrap" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ====== Live Log (collapsed expander) ====== -->
            <Expander Grid.Row="4" Header="Live Log" Margin="0,0,0,16"
                      Foreground="{StaticResource MutedForegroundBrush}">
                <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                    <Border BorderBrush="{StaticResource BorderColBrush}" BorderThickness="0,1,0,0"
                            Background="{StaticResource LogBgBrush}" CornerRadius="6"
                            MaxHeight="280">
                        <ListBox ItemsSource="{Binding LogEntries}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="11"
                                 AutomationProperties.Name="Live diagnostic log"
                                 AutomationProperties.LiveSetting="Polite">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                   Foreground="{StaticResource MutedForegroundBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Result}"
                                                   Foreground="{Binding ResultColor}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Border>
            </Expander>

            <!-- ====== Bottom action bar ====== -->
            <DockPanel Grid.Row="5">
                <Button DockPanel.Dock="Left"
                        Content="Open Adapter Settings"
                        Command="{Binding OpenAdapterSettingsCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        MinWidth="200" MinHeight="40"
                        AutomationProperties.Name="Open Windows network adapter settings" />
            </DockPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
