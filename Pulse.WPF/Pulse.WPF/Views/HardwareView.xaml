<UserControl x:Class="Pulse.WPF.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Pulse.WPF.ViewModels"
             xmlns:controls="clr-namespace:Pulse.WPF.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:HardwareViewModel, IsDesignTimeCreatable=True}"
             mc:Ignorable="d"
             Background="{StaticResource AppBgBrush}">

    <UserControl.Resources>
        <!-- Hardware-local sub-card style — mirrors NetSubCard / CcSubCard
             so the Peripherals card's three internal sections (GPU / Monitor /
             Input) read the same way as the rest of the app (v0.5.0). -->
        <Style x:Key="HwSubCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,12,14,12" />
        </Style>

        <Style x:Key="HwSubHeading" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,24,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- Header -->
                <RowDefinition Height="Auto" />   <!-- Findings banner -->
                <RowDefinition Height="Auto" />   <!-- 3-card top row -->
                <RowDefinition Height="Auto" />   <!-- PoE + NIC sidebar -->
                <RowDefinition Height="Auto" />   <!-- Log (collapsed expander) -->
                <RowDefinition Height="Auto" />   <!-- Action bar -->
            </Grid.RowDefinitions>

            <!-- ====== Section header ====== -->
            <DockPanel Grid.Row="0" Margin="0,0,0,24">
                <Border DockPanel.Dock="Right" Style="{StaticResource StatusChip}"
                        Background="{Binding StatusBg}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="9" Height="9" Fill="{Binding StatusColor}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold"
                                   Foreground="{Binding StatusColor}" Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <StackPanel>
                    <TextBlock Text="Hardware &amp; Peripherals" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="GPU, displays, input devices and PoE budget — what the box has and what's drawing power"
                               Style="{StaticResource PageSubtitle}" />
                </StackPanel>
            </DockPanel>

            <!-- ====== Findings banner ====== -->
            <controls:FindingsBanner Grid.Row="1"
                                     Findings="{Binding Findings}"
                                     Margin="0,0,0,16" />

            <!-- ====== Peripherals card (single, 3 internal sub-sections) ======
                 Was 3 separate top-row cards (GPU / Monitor / Input) — collapsed
                 v0.5.0 because at ≥1500 px the cards left ~50% blank columns.
                 The three internal sub-sections use the HwSubCard pattern. -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <controls:SectionHeader Title="Peripherals"
                                            Subtitle="GPU, monitor and input devices the OS can see right now." />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- GPU -->
                        <Border Grid.Column="0" Style="{StaticResource HwSubCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <md:PackIcon Kind="Gpu" Width="16" Height="16"
                                                 Foreground="{StaticResource AccentBrush}"
                                                 VerticalAlignment="Center" />
                                    <TextBlock Text="GPU" Style="{StaticResource HwSubHeading}" Margin="6,0,0,0" />
                                </DockPanel>
                                <TextBlock Text="{Binding GpuName}" Foreground="{StaticResource ForegroundBrush}"
                                           FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding GpuStatus}" Style="{StaticResource MutedLabel}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Monitor -->
                        <Border Grid.Column="2" Style="{StaticResource HwSubCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <md:PackIcon Kind="Monitor" Width="16" Height="16"
                                                 Foreground="{StaticResource AccentBrush}"
                                                 VerticalAlignment="Center" />
                                    <TextBlock Text="Monitor" Style="{StaticResource HwSubHeading}" Margin="6,0,0,0" />
                                </DockPanel>
                                <TextBlock Text="{Binding MonitorStatus}" Foreground="{StaticResource ForegroundBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Input devices -->
                        <Border Grid.Column="4" Style="{StaticResource HwSubCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <md:PackIcon Kind="MouseVariant" Width="16" Height="16"
                                                 Foreground="{StaticResource AccentBrush}"
                                                 VerticalAlignment="Center" />
                                    <TextBlock Text="Input Devices" Style="{StaticResource HwSubHeading}" Margin="6,0,0,0" />
                                </DockPanel>
                                <TextBlock Text="{Binding InputStatus}" Foreground="{StaticResource ForegroundBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ====== PoE table (NIC uptimes moved to Camera Connectivity v0.5.0) ====== -->
            <Grid Grid.Row="3" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- PoE -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock Text="PoE Status" Style="{StaticResource SectionTitle}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding PoeBudgetW}"
                                       Foreground="{StaticResource MutedForegroundBrush}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <!-- Empty-state copy when the SmartPoE driver bundle isn't installed (v0.5.0). -->
                        <Border DockPanel.Dock="Top"
                                Visibility="{Binding PoeAvailable, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                                Background="{StaticResource WarnBgBrush}"
                                BorderBrush="{StaticResource YellowBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,10"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="PoE telemetry not available"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource YellowBrush}"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="{Binding PoeUnavailableReason}"
                                           Foreground="{StaticResource ForegroundBrush}"
                                           TextWrapping="Wrap"
                                           FontSize="12" />
                            </StackPanel>
                        </Border>
                        <DataGrid ItemsSource="{Binding PoePorts}"
                                  Visibility="{Binding PoeAvailable, Converter={StaticResource BoolToVis}}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  IsReadOnly="True"
                                  RowBackground="Transparent"
                                  AlternatingRowBackground="#10FFFFFF"
                                  ColumnHeaderStyle="{x:Null}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="*" />
                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{Binding StateColor}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Padding" Value="8,0" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Voltage" Binding="{Binding Voltage}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MonoValue}">
                                            <Setter Property="Padding" Value="8,0" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Current" Binding="{Binding Current}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MonoValue}">
                                            <Setter Property="Padding" Value="8,0" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Wattage" Binding="{Binding Wattage}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MonoValue}">
                                            <Setter Property="Padding" Value="8,0" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

            </Grid>

            <!-- ====== Live Log (collapsed expander — matches Camera Connectivity) ====== -->
            <Expander Grid.Row="4" Header="Live Log" Margin="0,0,0,16"
                      Foreground="{StaticResource MutedForegroundBrush}">
                <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                    <Border BorderBrush="{StaticResource BorderColBrush}" BorderThickness="0,1,0,0"
                            Background="{StaticResource LogBgBrush}" CornerRadius="6"
                            MaxHeight="280">
                        <ListBox ItemsSource="{Binding LogEntries}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="11">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                   Foreground="{StaticResource MutedForegroundBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Result}"
                                                   Foreground="{Binding ResultColor}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Border>
            </Expander>

            <!-- ====== Action bar ====== -->
            <DockPanel Grid.Row="5">
                <Button DockPanel.Dock="Right"
                        Command="{Binding RunTestCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Padding="22,10" FontWeight="SemiBold"
                        MinWidth="160" MinHeight="44">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <md:PackIcon Kind="Refresh" Width="18" Height="18" VerticalAlignment="Center" />
                        <TextBlock Text="Refresh" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
