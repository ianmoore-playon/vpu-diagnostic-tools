<UserControl x:Class="Pulse.WPF.Views.EventViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Pulse.WPF.ViewModels"
             xmlns:controls="clr-namespace:Pulse.WPF.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:EventViewerViewModel}"
             mc:Ignorable="d"
             Background="{StaticResource AppBgBrush}">

    <UserControl.Resources>
        <!-- DataGrid styling copied from SystemOverview's Software Inventory
             grid so the two pages feel like siblings. -->
        <Style x:Key="EvDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderColBrush}" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="Transparent" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="RowHeight" Value="28" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        </Style>
        <Style x:Key="EvDataGridCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EvDataGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Padding" Value="8,4,8,8" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 0: header -->
            <RowDefinition Height="Auto" />   <!-- 1: findings banner -->
            <RowDefinition Height="Auto" />   <!-- 2: filter row -->
            <RowDefinition Height="*" />      <!-- 3: data grid -->
            <RowDefinition Height="Auto" />   <!-- 4: action bar -->
        </Grid.RowDefinitions>

        <!-- ====== Header ====== -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Border DockPanel.Dock="Right" Style="{StaticResource StatusChip}"
                    Background="{Binding StatusBg}"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Event Viewer status"
                    AutomationProperties.HelpText="{Binding StatusLabel}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" Fill="{Binding StatusColor}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold"
                               Foreground="{Binding StatusColor}" Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <StackPanel>
                <TextBlock Text="Event Viewer" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Filtered Windows event-log entries for disk, NIC, Pixellot, and core service sources"
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </DockPanel>

        <!-- ====== Findings banner (auto-collapse) ====== -->
        <controls:FindingsBanner Grid.Row="1"
                                 Margin="0,0,0,16"
                                 Findings="{Binding Findings}"
                                 AutomationProperties.Name="Event findings summary" />

        <!-- ====== Filter row ====== -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Time-window combobox -->
                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <TextBlock Text="TIME WINDOW"
                               FontFamily="Segoe UI Semibold" FontSize="10"
                               Foreground="{StaticResource MutedForegroundBrush}"
                               Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding WindowOptions}"
                              SelectedItem="{Binding SelectedWindow}"
                              MinWidth="140"
                              VerticalAlignment="Center"
                              AutomationProperties.Name="Event time window" />
                </StackPanel>

                <!-- Level checkboxes -->
                <StackPanel Grid.Column="2" Orientation="Vertical">
                    <TextBlock Text="LEVELS"
                               FontFamily="Segoe UI Semibold" FontSize="10"
                               Foreground="{StaticResource MutedForegroundBrush}"
                               Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Content="Error" IsChecked="{Binding ShowErrors}"
                                  Foreground="{StaticResource RedBrush}"
                                  Margin="0,0,12,0" />
                        <CheckBox Content="Warning" IsChecked="{Binding ShowWarnings}"
                                  Foreground="{StaticResource YellowBrush}"
                                  Margin="0,0,12,0" />
                        <CheckBox Content="Information" IsChecked="{Binding ShowInformation}"
                                  Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Source / message free-text -->
                <StackPanel Grid.Column="4" Orientation="Vertical">
                    <TextBlock Text="SOURCE OR MESSAGE CONTAINS"
                               FontFamily="Segoe UI Semibold" FontSize="10"
                               Foreground="{StaticResource MutedForegroundBrush}"
                               Margin="0,0,0,4" />
                    <TextBox Text="{Binding SourceFilter, UpdateSourceTrigger=PropertyChanged}"
                             md:HintAssist.Hint="e.g. disk, Pixellot, WHEA"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             VerticalAlignment="Center"
                             AutomationProperties.Name="Source or message filter" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ====== Entry DataGrid ====== -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,16">
            <DataGrid ItemsSource="{Binding EntriesView}"
                      Style="{StaticResource EvDataGrid}"
                      CellStyle="{StaticResource EvDataGridCell}"
                      ColumnHeaderStyle="{StaticResource EvDataGridHeader}"
                      AutomationProperties.Name="Event log entries">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Timestamp"
                                        Binding="{Binding TimestampLabel}"
                                        SortMemberPath="TimeGenerated"
                                        Width="140" />
                    <!-- Level column renders the chip via a CellTemplate so
                         the colour follows the per-row LevelColor / LevelBgBrush.
                         No converters, no FallbackValue hacks. -->
                    <DataGridTemplateColumn Header="Level" Width="100" SortMemberPath="Level">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="3" Padding="6,1,6,1"
                                        Background="{Binding LevelBgBrush}"
                                        BorderBrush="{Binding LevelColor}"
                                        BorderThickness="1"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Level}"
                                               Foreground="{Binding LevelColor}"
                                               FontWeight="SemiBold"
                                               FontSize="11" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Source"
                                        Binding="{Binding Source}"
                                        Width="180" />
                    <DataGridTextColumn Header="Event ID"
                                        Binding="{Binding EventId}"
                                        Width="80" />
                    <DataGridTextColumn Header="Message"
                                        Binding="{Binding Message}"
                                        Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="MaxHeight" Value="60" />
                                <Setter Property="ToolTip" Value="{Binding Message}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ====== Bottom action bar ====== -->
        <DockPanel Grid.Row="4">
            <Button DockPanel.Dock="Left"
                    Command="{Binding OpenEventViewerCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    MinWidth="200" MinHeight="44"
                    VerticalAlignment="Center"
                    ToolTip="Open the Windows Event Viewer (eventvwr.msc) for the full historical record.">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <md:PackIcon Kind="OpenInNew" Width="16" Height="16" VerticalAlignment="Center" />
                    <TextBlock Text="Open Windows Event Viewer" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    MinWidth="160" MinHeight="44"
                    VerticalAlignment="Center"
                    ToolTip="Re-read recent event-log entries with the current filter settings.">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <md:PackIcon Kind="Refresh" Width="18" Height="18" VerticalAlignment="Center" />
                    <TextBlock Text="Refresh" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DockPanel>
    </Grid>
</UserControl>
