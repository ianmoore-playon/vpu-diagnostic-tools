<UserControl x:Class="Pulse.WPF.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Pulse.WPF.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:ReportsViewModel}"
             mc:Ignorable="d"
             Background="{StaticResource AppBgBrush}">

    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 0: header -->
            <RowDefinition Height="*" />      <!-- 1: 2-column body -->
            <RowDefinition Height="Auto" />   <!-- 2: action bar -->
        </Grid.RowDefinitions>

        <!-- ====== Header ====== -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Border DockPanel.Dock="Right" Style="{StaticResource StatusChip}"
                    Background="{Binding StatusBg}"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Reports status"
                    AutomationProperties.HelpText="{Binding StatusLabel}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" Fill="{Binding StatusColor}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold"
                               Foreground="{Binding StatusColor}" Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <StackPanel>
                <TextBlock Text="Reports" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Past diagnostic-run snapshots — pick one on the left to read its full contents"
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </DockPanel>

        <!-- ====== Body: ListBox (left) + content viewer (right) ====== -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- Left: report list -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="DIAGNOSTIC RUNS"
                               FontFamily="Segoe UI Semibold" FontSize="11"
                               Foreground="{StaticResource MutedForegroundBrush}"
                               Margin="16,12,16,8" />
                    <!-- Empty state -->
                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Center"
                                Margin="0,40,0,0"
                                Visibility="{Binding HasNoReports, Converter={StaticResource BoolToVis}}">
                        <md:PackIcon Kind="FileDocumentOutline" Width="36" Height="36"
                                     Foreground="{StaticResource MutedForegroundBrush}"
                                     HorizontalAlignment="Center" />
                        <TextBlock Text="No diagnostic runs yet"
                                   Foreground="{StaticResource MutedForegroundBrush}"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Reports}"
                             SelectedItem="{Binding SelectedReport}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch"
                             AutomationProperties.Name="Saved diagnostic reports">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,8,8,8" Margin="0,0,0,2"
                                        BorderBrush="{StaticResource BorderColBrush}"
                                        BorderThickness="0,0,0,1">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding SizeLabel}"
                                                       FontFamily="Cascadia Mono, Consolas"
                                                       FontSize="10"
                                                       Foreground="{StaticResource MutedForegroundBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding TimestampLabel}"
                                                       FontFamily="Segoe UI Semibold" FontSize="12"
                                                       Foreground="{StaticResource ForegroundBrush}" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding FileName}"
                                                   FontFamily="Cascadia Mono, Consolas" FontSize="10"
                                                   Foreground="{StaticResource SubtleForegroundBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding Notes}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedForegroundBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,4,0,0"
                                                   Visibility="{Binding Notes, Converter={StaticResource StringToVis}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right: report content -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="16,12,16,8">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="REPORT CONTENTS"
                                   FontFamily="Segoe UI Semibold" FontSize="11"
                                   Foreground="{StaticResource MutedForegroundBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding SelectedReport.FileName}"
                                   FontFamily="Cascadia Mono, Consolas" FontSize="10"
                                   Foreground="{StaticResource SubtleForegroundBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <Border Grid.Row="1"
                            Background="{StaticResource LogBgBrush}"
                            BorderBrush="{StaticResource BorderColBrush}"
                            BorderThickness="0,1,0,0">
                        <TextBox Text="{Binding SelectedReportContent, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Background="Transparent"
                                 Foreground="{StaticResource ForegroundBrush}"
                                 BorderThickness="0"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="11"
                                 Padding="14,12,14,12"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 AcceptsReturn="True"
                                 AutomationProperties.Name="Selected report contents" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ====== Bottom action bar ====== -->
        <DockPanel Grid.Row="2">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Command="{Binding OpenFolderCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        MinWidth="180" MinHeight="44"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"
                        ToolTip="Open the reports folder in Windows Explorer.">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <md:PackIcon Kind="FolderOpenOutline" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Text="Open Reports Folder" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding DeleteCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        MinWidth="160" MinHeight="44"
                        VerticalAlignment="Center"
                        ToolTip="Delete the selected report. You'll be asked to confirm.">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <md:PackIcon Kind="DeleteOutline" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Text="Delete Report" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <Button DockPanel.Dock="Right"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    MinWidth="160" MinHeight="44"
                    VerticalAlignment="Center"
                    ToolTip="Re-read the reports folder.">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <md:PackIcon Kind="Refresh" Width="18" Height="18" VerticalAlignment="Center" />
                    <TextBlock Text="Refresh" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DockPanel>
    </Grid>
</UserControl>
