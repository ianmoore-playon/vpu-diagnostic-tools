<UserControl x:Class="Pulse.WPF.Views.ServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Pulse.WPF.ViewModels"
             xmlns:controls="clr-namespace:Pulse.WPF.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:ServicesViewModel, IsDesignTimeCreatable=True}"
             mc:Ignorable="d"
             Background="{StaticResource AppBgBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,24,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- Header + actions -->
                <RowDefinition Height="Auto" />   <!-- Findings banner -->
                <RowDefinition Height="Auto" />   <!-- Fresh boot notice -->
                <RowDefinition Height="Auto" />   <!-- 6 service cards -->
                <RowDefinition Height="Auto" />   <!-- Dependencies -->
                <RowDefinition Height="Auto" />   <!-- Log (collapsed expander) -->
            </Grid.RowDefinitions>

            <!-- ====== Section header ======
                 Restart Service only enables for rows backed by a real
                 Windows service name; process-only rows are observational. -->
            <DockPanel Grid.Row="0" Margin="0,0,0,24">
                <Border DockPanel.Dock="Right" Style="{StaticResource StatusChip}"
                        Background="{Binding StatusBg}" Margin="8,0,0,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="9" Height="9" Fill="{Binding StatusColor}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold"
                                   Foreground="{Binding StatusColor}" Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding RestartServiceCommand}"
                            Style="{StaticResource TopBarOutlinedButton}"
                            ToolTip="{Binding SelectedServiceRestartHint}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <md:PackIcon Kind="Restart" Width="16" Height="16" VerticalAlignment="Center" />
                            <TextBlock Text="Restart Service" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RunTestCommand}"
                            Style="{StaticResource TopBarPrimaryButton}"
                            ToolTip="Re-poll the Pixellot processes and Windows services they depend on.">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <md:PackIcon Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center"
                                         Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="Refresh" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="VPU Processes &amp; Services" Style="{StaticResource PageTitle}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="Pixellot process health and restartable Windows service checks"
                               Style="{StaticResource PageSubtitle}"
                               TextTrimming="CharacterEllipsis" MaxWidth="640" />
                </StackPanel>
            </DockPanel>

            <controls:FindingsBanner Grid.Row="1"
                                     Findings="{Binding Findings}"
                                     Margin="0,0,0,16" />

            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,16"
                    Background="{StaticResource WarnBgBrush}"
                    BorderBrush="{StaticResource YellowBrush}"
                    Visibility="{Binding HasStartupGraceNotice, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <md:PackIcon DockPanel.Dock="Left" Kind="ClockOutline"
                                 Width="22" Height="22"
                                 Foreground="{StaticResource YellowBrush}"
                                 VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel>
                        <TextBlock Text="Fresh boot grace window"
                                   FontFamily="Segoe UI Semibold"
                                   FontSize="14"
                                   Foreground="{StaticResource ForegroundBrush}" />
                        <TextBlock Text="{Binding StartupGraceNoticeText}"
                                   Foreground="{StaticResource MutedForegroundBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ====== v0.6.6 loading placeholder ======
                 Visible until the first RefreshAsync populates the
                 Services collection. Stops the panel from looking
                 broken on the first 1-2 s of cold-start before
                 BaselineRunner Phase 1 lands. Hidden the moment
                 IsReady flips true (see ServicesViewModel.IsLoading). -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,16"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Margin="0,16,0,16">
                    <md:PackIcon Kind="DotsHorizontalCircleOutline" Width="20" Height="20"
                                 Foreground="{StaticResource MutedForegroundBrush}"
                                 VerticalAlignment="Center" />
                    <TextBlock Text="Services panel is loading…"
                               Foreground="{StaticResource MutedForegroundBrush}"
                               FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- ====== VPU process cards ======
                 v0.6.6: also gated on IsReady so the WrapPanel doesn't
                 reserve empty space below the placeholder above. -->
            <ItemsControl Grid.Row="3" ItemsSource="{Binding CoreServices}" Margin="0,0,0,16"
                          Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}"
                                Width="280" Height="148"
                                Margin="0,0,12,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Top row: name + status pill -->
                                <DockPanel Grid.Row="0">
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontFamily="Segoe UI Semibold" FontSize="14"
                                               Foreground="{StaticResource ForegroundBrush}" TextWrapping="Wrap" />
                                </DockPanel>

                                <!-- Middle: name (mono) + start mode -->
                                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource MonoValue}" />
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource MutedLabel}">
                                        <Run Text="Start mode: " />
                                        <Run Text="{Binding StartMode, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding LastStarted}" Style="{StaticResource MutedLabel}" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding Note}" Foreground="{StaticResource YellowBrush}"
                                               FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- Bottom: status pill -->
                                <Border Grid.Row="2" Style="{StaticResource StatusChipSm}"
                                        Background="{Binding StatusBg}" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="11"
                                                   Foreground="{Binding StatusColor}" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ====== Restartable Windows services ====== -->
            <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,0,0,16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Windows Services"
                               Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                    <DataGrid ItemsSource="{Binding SystemDependencies}"
                              SelectedItem="{Binding SelectedService, Mode=TwoWay}"
                              SelectionMode="Single"
                              Background="Transparent"
                              BorderThickness="0"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              IsReadOnly="True"
                              RowBackground="Transparent"
                              AlternatingRowBackground="#10FFFFFF">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Service" Binding="{Binding DisplayName}" Width="*" />
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MonoValue}">
                                        <Setter Property="Padding" Value="8,0" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Start mode" Binding="{Binding StartMode}" Width="Auto">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
                                        <Setter Property="Padding" Value="8,0" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding StatusColor}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Padding" Value="8,0" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Restart" Binding="{Binding RestartAvailability}" Width="2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
                                        <Setter Property="Padding" Value="8,0" />
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- ====== Live Log (collapsed expander — matches Camera Connectivity) ====== -->
            <Expander Grid.Row="5" Header="Live Log" Margin="0,0,0,16"
                      Foreground="{StaticResource MutedForegroundBrush}">
                <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                    <Border BorderBrush="{StaticResource BorderColBrush}" BorderThickness="0,1,0,0"
                            Background="{StaticResource LogBgBrush}" CornerRadius="6"
                            MaxHeight="280">
                        <ListBox ItemsSource="{Binding LogEntries}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="11">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                   Foreground="{StaticResource MutedForegroundBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Result}"
                                                   Foreground="{Binding ResultColor}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Border>
            </Expander>

        </Grid>
    </ScrollViewer>
</UserControl>
