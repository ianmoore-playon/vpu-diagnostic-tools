<UserControl x:Class="Pulse.WPF.Views.SystemOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Pulse.WPF.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:SystemOverviewViewModel, IsDesignTimeCreatable=True}"
             mc:Ignorable="d"
             Background="{StaticResource AppBgBrush}">

    <UserControl.Resources>
        <!-- Compact summary card used by the 6-tile top row.
             Reuses the standard Card style; the inner template is repeated
             per card via inline definitions below to keep binding clear. -->
        <Style x:Key="SiSummaryCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="14,12,14,12" />
            <Setter Property="MinHeight" Value="86" />
        </Style>

        <!-- Inventory row template — same layout for section headings and
             data rows; the Section text is non-empty only on heading rows
             and Label/Value are non-empty only on data rows. WPF collapses
             zero-length text naturally so a single template handles both. -->
        <DataTemplate x:Key="SiInventoryRowTemplate">
            <StackPanel>
                <!-- Section heading (rendered when Section is non-empty) -->
                <TextBlock Text="{Binding Section}"
                           FontFamily="Segoe UI Semibold" FontSize="10"
                           Foreground="{StaticResource MutedForegroundBrush}"
                           Margin="0,14,0,6"
                           Visibility="{Binding Section, Converter={StaticResource StringToVis}}" />

                <!-- Data row: Label (Consolas, muted) + Value (Consolas, level-coloured) -->
                <Grid Visibility="{Binding Label, Converter={StaticResource StringToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                               FontFamily="Consolas" FontSize="11"
                               Foreground="{StaticResource SubtleForegroundBrush}"
                               Margin="0,2,8,2" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}"
                               FontFamily="Consolas" FontSize="11"
                               Foreground="{Binding ValueColor}"
                               TextWrapping="Wrap" Margin="0,2,0,2" />
                </Grid>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- Section header -->
            <RowDefinition Height="Auto" />   <!-- 6 summary tiles -->
            <RowDefinition Height="*" />      <!-- Inventory (full width) -->
            <RowDefinition Height="Auto" />   <!-- Action bar -->
        </Grid.RowDefinitions>

        <!-- ====== Section header ====== -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <Border DockPanel.Dock="Right" Style="{StaticResource StatusChip}"
                    Background="{Binding StatusBg}"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" Fill="{Binding StatusColor}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold"
                               Foreground="{Binding StatusColor}" Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <StackPanel>
                <TextBlock Text="System Overview" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Hardware, software, and operating-system specs for this VPU. Use Refresh after a hardware change."
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </DockPanel>

        <!-- ====== Six summary tiles ======
             Sub-captions removed — the tile titles (Model / OS / Uptime / CPU /
             RAM / Storage) speak for themselves. -->
        <UniformGrid Grid.Row="1" Rows="1" Columns="6" Margin="0,0,0,20">

            <Border Style="{StaticResource SiSummaryCard}" Margin="0,0,8,0">
                <StackPanel>
                    <DockPanel>
                        <Ellipse DockPanel.Dock="Right" Width="10" Height="10"
                                 Fill="{Binding ModelStatusColor}" VerticalAlignment="Center" />
                        <TextBlock Text="Model"
                                   FontFamily="Segoe UI Semibold" FontSize="10"
                                   Foreground="{StaticResource MutedForegroundBrush}" />
                    </DockPanel>
                    <TextBlock Text="{Binding ModelTitle}"
                               FontFamily="Segoe UI Semibold" FontSize="13"
                               Foreground="{StaticResource ForegroundBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SiSummaryCard}" Margin="4,0,4,0">
                <StackPanel>
                    <DockPanel>
                        <Ellipse DockPanel.Dock="Right" Width="10" Height="10"
                                 Fill="{Binding OsStatusColor}" VerticalAlignment="Center" />
                        <TextBlock Text="OS"
                                   FontFamily="Segoe UI Semibold" FontSize="10"
                                   Foreground="{StaticResource MutedForegroundBrush}" />
                    </DockPanel>
                    <TextBlock Text="{Binding OsTitle}"
                               FontFamily="Segoe UI Semibold" FontSize="13"
                               Foreground="{StaticResource ForegroundBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SiSummaryCard}" Margin="4,0,4,0">
                <StackPanel>
                    <DockPanel>
                        <md:PackIcon DockPanel.Dock="Right" Kind="ClockOutline"
                                     Width="14" Height="14"
                                     Foreground="{Binding UptimeStatusColor}" VerticalAlignment="Center" />
                        <TextBlock Text="Uptime"
                                   FontFamily="Segoe UI Semibold" FontSize="10"
                                   Foreground="{StaticResource MutedForegroundBrush}" />
                    </DockPanel>
                    <TextBlock Text="{Binding UptimeTitle}"
                               FontFamily="Segoe UI Semibold" FontSize="13"
                               Foreground="{StaticResource ForegroundBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SiSummaryCard}" Margin="4,0,4,0">
                <StackPanel>
                    <DockPanel>
                        <Ellipse DockPanel.Dock="Right" Width="10" Height="10"
                                 Fill="{Binding CpuStatusColor}" VerticalAlignment="Center" />
                        <TextBlock Text="CPU"
                                   FontFamily="Segoe UI Semibold" FontSize="10"
                                   Foreground="{StaticResource MutedForegroundBrush}" />
                    </DockPanel>
                    <TextBlock Text="{Binding CpuTitle}"
                               FontFamily="Segoe UI Semibold" FontSize="13"
                               Foreground="{StaticResource ForegroundBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SiSummaryCard}" Margin="4,0,4,0">
                <StackPanel>
                    <DockPanel>
                        <md:PackIcon DockPanel.Dock="Right" Kind="Memory"
                                     Width="14" Height="14"
                                     Foreground="{Binding RamStatusColor}" VerticalAlignment="Center" />
                        <TextBlock Text="RAM"
                                   FontFamily="Segoe UI Semibold" FontSize="10"
                                   Foreground="{StaticResource MutedForegroundBrush}" />
                    </DockPanel>
                    <TextBlock Text="{Binding RamTitle}"
                               FontFamily="Segoe UI Semibold" FontSize="13"
                               Foreground="{StaticResource ForegroundBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SiSummaryCard}" Margin="8,0,0,0">
                <StackPanel>
                    <DockPanel>
                        <md:PackIcon DockPanel.Dock="Right" Kind="Harddisk"
                                     Width="14" Height="14"
                                     Foreground="{Binding StorageStatusColor}" VerticalAlignment="Center" />
                        <TextBlock Text="Storage"
                                   FontFamily="Segoe UI Semibold" FontSize="10"
                                   Foreground="{StaticResource MutedForegroundBrush}" />
                    </DockPanel>
                    <TextBlock Text="{Binding StorageTitle}"
                               FontFamily="Segoe UI Semibold" FontSize="13"
                               Foreground="{StaticResource ForegroundBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ====== Inventory (full-width) ======
             The right-column "Summary" card was a byte-for-byte restatement
             of the 6 tiles above; removed in v0.4 per the UX review. The
             inventory now gets the full content width. -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="System Inventory"
                           Style="{StaticResource SectionTitle}" Margin="4,0,0,12" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Inventory}"
                                  ItemTemplate="{StaticResource SiInventoryRowTemplate}" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ====== Bottom action bar ======
             Refresh + Copy-as-text. Copy puts the entire inventory on the
             clipboard, formatted for pasting into a support ticket. -->
        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Command="{Binding CopyAsTextCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Padding="16,8" Margin="0,0,8,0"
                        ToolTip="Copy the entire inventory to the clipboard, formatted for pasting into a support ticket.">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="ContentCopy" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Text="Copy as text" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding RefreshCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Padding="22,10" FontWeight="SemiBold"
                        ToolTip="Re-read live data from Windows. Use after a hardware change, driver update, or BIOS update.">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Refresh" Width="18" Height="18" VerticalAlignment="Center" />
                        <TextBlock Text="Refresh" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Text="{Binding CopyStatus}"
                       Foreground="{StaticResource MutedForegroundBrush}"
                       VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</UserControl>
