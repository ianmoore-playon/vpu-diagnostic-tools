<UserControl x:Class="Pulse.WPF.Views.SystemOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Pulse.WPF.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:SystemOverviewViewModel, IsDesignTimeCreatable=True}"
             mc:Ignorable="d"
             Background="{StaticResource AppBgBrush}">

    <UserControl.Resources>
        <!-- Compact summary card used by the 6-tile top row.
             Reuses the standard Card style; the inner template is repeated
             per card via inline definitions below to keep binding clear. -->
        <Style x:Key="SiSummaryCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="14,12,14,12" />
            <Setter Property="MinHeight" Value="86" />
        </Style>

        <!-- Inventory row template — same layout for section headings and
             data rows; the Section text is non-empty only on heading rows
             and Label/Value are non-empty only on data rows. WPF collapses
             zero-length text naturally so a single template handles both. -->
        <DataTemplate x:Key="SiInventoryRowTemplate">
            <StackPanel>
                <!-- Section heading (rendered when Section is non-empty) -->
                <TextBlock Text="{Binding Section}"
                           FontFamily="Segoe UI Semibold" FontSize="10"
                           Foreground="{StaticResource MutedForegroundBrush}"
                           Margin="0,14,0,6"
                           Visibility="{Binding Section, Converter={StaticResource StringToVis}}" />

                <!-- Data row: Label (Consolas, muted) + Value (Consolas, level-coloured) -->
                <Grid Visibility="{Binding Label, Converter={StaticResource StringToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                               FontFamily="Consolas" FontSize="11"
                               Foreground="{StaticResource SubtleForegroundBrush}"
                               Margin="0,2,8,2" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}"
                               FontFamily="Consolas" FontSize="11"
                               Foreground="{Binding ValueColor}"
                               TextWrapping="Wrap" Margin="0,2,0,2" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- Summary bullet template — colored dot + text. -->
        <DataTemplate x:Key="SiSummaryRowTemplate">
            <DockPanel Margin="0,3,0,3">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource MutedForegroundBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="ok">
                                    <Setter Property="Fill" Value="{StaticResource GreenBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="warn">
                                    <Setter Property="Fill" Value="{StaticResource YellowBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="fail">
                                    <Setter Property="Fill" Value="{StaticResource RedBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding Text}"
                           Foreground="{StaticResource ForegroundBrush}"
                           TextWrapping="Wrap" />
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- Section header -->
            <RowDefinition Height="Auto" />   <!-- 6 summary cards -->
            <RowDefinition Height="*" />      <!-- Two-column: Inventory + Summary -->
            <RowDefinition Height="Auto" />   <!-- Action bar -->
        </Grid.RowDefinitions>

        <!-- ====== Section header ====== -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <Border DockPanel.Dock="Right" Style="{StaticResource StatusChip}"
                    Background="{Binding StatusBg}"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" Fill="{Binding StatusColor}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold"
                               Foreground="{Binding StatusColor}" Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <StackPanel>
                <TextBlock Text="System Overview" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Hardware specs, OS version, uptime, time/locale, and Pixellot software inventory."
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </DockPanel>

        <!-- ====== Six summary cards ====== -->
        <UniformGrid Grid.Row="1" Rows="1" Columns="6" Margin="0,0,0,20">
            <UniformGrid.Resources>
                <!-- Per-card text styles -->
            </UniformGrid.Resources>

            <Border Style="{StaticResource SiSummaryCard}" Margin="0,0,8,0">
                <StackPanel>
                    <DockPanel>
                        <Ellipse DockPanel.Dock="Right" Width="10" Height="10"
                                 Fill="{Binding ModelStatusColor}" VerticalAlignment="Center" />
                        <TextBlock Text="Model"
                                   FontFamily="Segoe UI Semibold" FontSize="10"
                                   Foreground="{StaticResource MutedForegroundBrush}" />
                    </DockPanel>
                    <TextBlock Text="{Binding ModelTitle}"
                               FontFamily="Segoe UI Semibold" FontSize="13"
                               Foreground="{StaticResource ForegroundBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,4" />
                    <TextBlock Text="Manufacturer + product"
                               FontSize="10" Foreground="{StaticResource SubtleForegroundBrush}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SiSummaryCard}" Margin="4,0,4,0">
                <StackPanel>
                    <DockPanel>
                        <Ellipse DockPanel.Dock="Right" Width="10" Height="10"
                                 Fill="{Binding OsStatusColor}" VerticalAlignment="Center" />
                        <TextBlock Text="OS"
                                   FontFamily="Segoe UI Semibold" FontSize="10"
                                   Foreground="{StaticResource MutedForegroundBrush}" />
                    </DockPanel>
                    <TextBlock Text="{Binding OsTitle}"
                               FontFamily="Segoe UI Semibold" FontSize="13"
                               Foreground="{StaticResource ForegroundBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,4" />
                    <TextBlock Text="Edition + build"
                               FontSize="10" Foreground="{StaticResource SubtleForegroundBrush}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SiSummaryCard}" Margin="4,0,4,0">
                <StackPanel>
                    <DockPanel>
                        <md:PackIcon DockPanel.Dock="Right" Kind="ClockOutline"
                                     Width="14" Height="14"
                                     Foreground="{Binding UptimeStatusColor}" VerticalAlignment="Center" />
                        <TextBlock Text="Uptime"
                                   FontFamily="Segoe UI Semibold" FontSize="10"
                                   Foreground="{StaticResource MutedForegroundBrush}" />
                    </DockPanel>
                    <TextBlock Text="{Binding UptimeTitle}"
                               FontFamily="Segoe UI Semibold" FontSize="13"
                               Foreground="{StaticResource ForegroundBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,4" />
                    <TextBlock Text="Since last boot"
                               FontSize="10" Foreground="{StaticResource SubtleForegroundBrush}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SiSummaryCard}" Margin="4,0,4,0">
                <StackPanel>
                    <DockPanel>
                        <Ellipse DockPanel.Dock="Right" Width="10" Height="10"
                                 Fill="{Binding CpuStatusColor}" VerticalAlignment="Center" />
                        <TextBlock Text="CPU"
                                   FontFamily="Segoe UI Semibold" FontSize="10"
                                   Foreground="{StaticResource MutedForegroundBrush}" />
                    </DockPanel>
                    <TextBlock Text="{Binding CpuTitle}"
                               FontFamily="Segoe UI Semibold" FontSize="13"
                               Foreground="{StaticResource ForegroundBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,4" />
                    <TextBlock Text="Processor"
                               FontSize="10" Foreground="{StaticResource SubtleForegroundBrush}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SiSummaryCard}" Margin="4,0,4,0">
                <StackPanel>
                    <DockPanel>
                        <md:PackIcon DockPanel.Dock="Right" Kind="Memory"
                                     Width="14" Height="14"
                                     Foreground="{Binding RamStatusColor}" VerticalAlignment="Center" />
                        <TextBlock Text="RAM"
                                   FontFamily="Segoe UI Semibold" FontSize="10"
                                   Foreground="{StaticResource MutedForegroundBrush}" />
                    </DockPanel>
                    <TextBlock Text="{Binding RamTitle}"
                               FontFamily="Segoe UI Semibold" FontSize="13"
                               Foreground="{StaticResource ForegroundBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,4" />
                    <TextBlock Text="Installed memory"
                               FontSize="10" Foreground="{StaticResource SubtleForegroundBrush}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SiSummaryCard}" Margin="8,0,0,0">
                <StackPanel>
                    <DockPanel>
                        <md:PackIcon DockPanel.Dock="Right" Kind="Harddisk"
                                     Width="14" Height="14"
                                     Foreground="{Binding StorageStatusColor}" VerticalAlignment="Center" />
                        <TextBlock Text="Storage"
                                   FontFamily="Segoe UI Semibold" FontSize="10"
                                   Foreground="{StaticResource MutedForegroundBrush}" />
                    </DockPanel>
                    <TextBlock Text="{Binding StorageTitle}"
                               FontFamily="Segoe UI Semibold" FontSize="13"
                               Foreground="{StaticResource ForegroundBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,4" />
                    <TextBlock Text="System drive free space"
                               FontSize="10" Foreground="{StaticResource SubtleForegroundBrush}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ====== Two-column main: Inventory (left) + Summary (right) ====== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- Inventory card (scrolling list of section headings + label/value rows) -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="System Inventory"
                               Style="{StaticResource SectionTitle}" Margin="4,0,0,12" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Inventory}"
                                      ItemTemplate="{StaticResource SiInventoryRowTemplate}" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Summary card (right column) -->
            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Summary" Style="{StaticResource SectionTitle}" Margin="4,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Summary}"
                                  ItemTemplate="{StaticResource SiSummaryRowTemplate}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ====== Bottom action bar ====== -->
        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Padding="22,10" FontWeight="SemiBold">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="Refresh" Width="18" Height="18" VerticalAlignment="Center" />
                    <TextBlock Text="Refresh" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
            <TextBlock Text="System Inventory is read live from WMI, registry, and the filesystem. Click Refresh after a config change."
                       Foreground="{StaticResource MutedForegroundBrush}"
                       VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</UserControl>
