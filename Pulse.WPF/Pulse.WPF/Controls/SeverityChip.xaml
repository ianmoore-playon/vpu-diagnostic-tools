<!--
    SeverityChip — small inline chip ("PASS" / "WARN" / "FAIL" / "INFO").
    Used in tables and findings rows.
-->
<UserControl x:Class="Pulse.WPF.Controls.SeverityChip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="Root">

    <Border CornerRadius="4"
            Padding="8,2"
            MinWidth="48"
            HorizontalAlignment="Left"
            Background="{Binding ElementName=Root, Path=ResolvedBg}">
        <TextBlock Text="{Binding ElementName=Root, Path=Text}"
                   Foreground="{Binding ElementName=Root, Path=ResolvedFg}"
                   FontWeight="SemiBold"
                   FontSize="11"
                   HorizontalAlignment="Center" />
    </Border>
</UserControl>
