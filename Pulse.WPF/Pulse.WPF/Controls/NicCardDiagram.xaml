<!--
    NicCardDiagram — schematic of the camera-NIC card sitting above the
    4-tile UniformGrid in the Camera Connectivity panel.

    v0.8.13-beta: visual polish pass.
      - Dropped the 12-px connector-line stubs under each jack (they
        added visual noise without diagnostic value; the four
        UniformGrid columns already align the jacks vertically with the
        tiles below).
      - Increased card padding so the diagram fills its container.
      - Vertical LED status strip on the right grew from 10-px LEDs +
        10-pt labels to 16-px LEDs + 13-pt labels for desk-monitor
        scannability.
      - JackVisual itself grew 28x22 -> 52x42 (see that file).

    The bound Ports collection is expected to be in physical order
    (Port 4 <- 3 <- 2 <- 1, left to right) - the host VM produces this
    via PortsByPhysical, mirroring the visual layout of the real card.

    The vertical LED strip on the right is a redundant indicator of the
    same per-port link state (drives the same LinkLedBrush as the
    per-jack LEDs). Matches the physical card's vertical status-light
    strip so techs can map "Pulse says Port 2 LED is yellow" to "the
    second LED from the bottom is yellow on the actual card."

    Bind Ports="{Binding PortsByPhysical}" with an
    ObservableCollection<PortViewModel> from CameraConnectivityViewModel.
    The control is intentionally pure layout with no behaviour - port
    state bubbles in via PortViewModel.LinkLedBrush etc.
-->
<UserControl x:Class="Pulse.WPF.Controls.NicCardDiagram"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Pulse.WPF.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="Root">

    <Border CornerRadius="6"
            Background="{DynamicResource SurfaceBgBrush}"
            BorderBrush="{DynamicResource BorderColBrush}"
            BorderThickness="1"
            Padding="20,18,20,18"
            Margin="0,0,0,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left column: 4 horizontal jacks (no connector stubs) -->
            <ItemsControl Grid.Column="0"
                          ItemsSource="{Binding Ports, ElementName=Root}"
                          AlternationCount="4"
                          VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- v0.8.6-beta: jack badge reads PortViewModel.Name
                             directly (e.g. "Port 4") so each jack is
                             labeled by its physical number regardless of
                             UniformGrid index. PortNumberLabel is a string
                             property on JackVisual. -->
                        <controls:JackVisual PortNumberLabel="{Binding Name}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Right column: vertical status-light strip (v0.8.6-beta,
                 scaled up in v0.8.13-beta). Mirrors the physical card's
                 vertical LED indicator strip. Top -> bottom = Port 4 ->
                 3 -> 2 -> 1, matching the PortsByPhysical iteration
                 order. Each LED reads the same LinkLedBrush as its
                 corresponding jack so they're always in sync. -->
            <Border Grid.Column="1"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource BorderColBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,12"
                    Margin="20,0,0,0"
                    VerticalAlignment="Center">
                <ItemsControl ItemsSource="{Binding Ports, ElementName=Root}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                                <Ellipse Width="16" Height="16"
                                         Fill="{Binding LinkLedBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}"
                                           Margin="10,0,0,0"
                                           FontSize="13"
                                           FontFamily="Segoe UI Semibold"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>
    </Border>
</UserControl>
