<!--
    JackVisual — one RJ45 jack rendering for the Camera Connectivity NIC card
    diagram. Bind to a PortViewModel: the LED dot picks up LinkLedBrush, the
    "1"/"2" badge picks up Name (last token). Pure visual, no logic.

    Geometry:
        ┌──────────────┐   ← 28 × 22 jack outline (rounded, 1px border)
        │  ▔▔  ▔▔      │   ← two thin spring-tab hint rectangles
        │              │
        │      ●       │   ← 8 × 8 LED ellipse (LinkLedBrush)
        └──────┬───────┘
               │           ← connector line down to tile (3 px stub here;
               │             the long line lives in NicCardDiagram so it
               │             can extend to the tile row).
              [N]          ← port-number text under the jack
-->
<UserControl x:Class="Pulse.WPF.Controls.JackVisual"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="Root"
             SnapsToDevicePixels="True">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">

        <!-- RJ45 outline -->
        <Border Width="28" Height="22"
                CornerRadius="2"
                Background="{DynamicResource CardBgRaisedBrush}"
                BorderBrush="{DynamicResource BorderColStrongBrush}"
                BorderThickness="1"
                HorizontalAlignment="Center"
                ToolTip="{Binding StatusLine}">
            <Grid>
                <!-- Spring-tab hint: two thin lines near the top -->
                <Rectangle Width="6" Height="2"
                           Fill="{DynamicResource BorderColStrongBrush}"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Margin="5,2,0,0" />
                <Rectangle Width="6" Height="2"
                           Fill="{DynamicResource BorderColStrongBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top"
                           Margin="0,2,5,0" />

                <!-- LED. Fill binds to PortViewModel.LinkLedBrush; while the
                     VM hasn't computed it yet the Ellipse renders transparent
                     (no FallbackValue used, because nesting a DynamicResource
                     inside a Binding's FallbackValue is invalid in inline
                     markup-extension syntax — that exact pattern was the
                     XamlParseException that froze the whole tab in v0.4.6). -->
                <Ellipse Width="8" Height="8"
                         Fill="{Binding LinkLedBrush}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Bottom"
                         Margin="0,0,0,3" />
            </Grid>
        </Border>

        <!-- Port-number badge -->
        <Border Margin="0,4,0,0"
                CornerRadius="6"
                Padding="6,1"
                HorizontalAlignment="Center"
                Background="{DynamicResource SurfaceBgBrush}"
                BorderBrush="{DynamicResource BorderColBrush}"
                BorderThickness="1">
            <TextBlock Text="{Binding PortNumberLabel, ElementName=Root, FallbackValue='1'}"
                       FontSize="10"
                       FontFamily="Segoe UI Semibold"
                       Foreground="{DynamicResource MutedForegroundBrush}"
                       HorizontalAlignment="Center" />
        </Border>
    </StackPanel>
</UserControl>
