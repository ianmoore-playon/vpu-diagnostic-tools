<!--
    JackVisual — one RJ45 jack rendering for the Camera Connectivity NIC card
    diagram. Bind to a PortViewModel: the LED dot picks up LinkLedBrush, the
    "Port N" badge picks up Name. Pure visual, no logic.

    v0.8.13-beta: scaled up (28x22 -> 52x42 outline) so the diagram strip
    actually fills the card and is scannable at desk-monitor distance. Badge
    font + LED also scaled.

    Geometry:
        ┌────────────────────────┐   ← 52 × 42 jack outline (rounded, 1px border)
        │  ▔▔▔▔      ▔▔▔▔        │   ← two thin spring-tab hint rectangles
        │                        │
        │           ●            │   ← 14 × 14 LED ellipse (LinkLedBrush)
        └────────────────────────┘
                [ Port N ]            ← port-number badge under the jack
-->
<UserControl x:Class="Pulse.WPF.Controls.JackVisual"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="Root"
             SnapsToDevicePixels="True">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">

        <!-- RJ45 outline -->
        <Border Width="52" Height="42"
                CornerRadius="3"
                Background="{DynamicResource CardBgRaisedBrush}"
                BorderBrush="{DynamicResource BorderColStrongBrush}"
                BorderThickness="1"
                HorizontalAlignment="Center"
                ToolTip="{Binding StatusLine}">
            <Grid>
                <!-- Spring-tab hint: two thin lines near the top -->
                <Rectangle Width="12" Height="3"
                           Fill="{DynamicResource BorderColStrongBrush}"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Margin="8,4,0,0" />
                <Rectangle Width="12" Height="3"
                           Fill="{DynamicResource BorderColStrongBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top"
                           Margin="0,4,8,0" />

                <!-- LED. Fill binds to PortViewModel.LinkLedBrush; while the
                     VM hasn't computed it yet the Ellipse renders transparent
                     (no FallbackValue used, because nesting a DynamicResource
                     inside a Binding's FallbackValue is invalid in inline
                     markup-extension syntax — that exact pattern was the
                     XamlParseException that froze the whole tab in v0.4.6). -->
                <Ellipse Width="14" Height="14"
                         Fill="{Binding LinkLedBrush}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Bottom"
                         Margin="0,0,0,6" />
            </Grid>
        </Border>

        <!-- Port-number badge -->
        <Border Margin="0,8,0,0"
                CornerRadius="6"
                Padding="10,2"
                HorizontalAlignment="Center"
                Background="{DynamicResource SurfaceBgBrush}"
                BorderBrush="{DynamicResource BorderColBrush}"
                BorderThickness="1">
            <TextBlock Text="{Binding PortNumberLabel, ElementName=Root, FallbackValue='Port 1'}"
                       FontSize="12"
                       FontFamily="Segoe UI Semibold"
                       Foreground="{DynamicResource MutedForegroundBrush}"
                       HorizontalAlignment="Center" />
        </Border>
    </StackPanel>
</UserControl>
