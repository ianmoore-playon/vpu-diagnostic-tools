<!--
    StatusPill — section-header pill (top-right of every panel).
    Auto-pulls colors from the current theme based on Severity.
    Bind:
        <controls:StatusPill Label="All Clear" Severity="ok" />
    Severity values: "ok" / "warn" / "fail" / "neutral" / "running".
-->
<UserControl x:Class="Pulse.WPF.Controls.StatusPill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="Root">

    <Border x:Name="PART_Bg"
            CornerRadius="14"
            Padding="14,6"
            Background="{Binding ElementName=Root, Path=ResolvedBg}">
        <StackPanel Orientation="Horizontal">
            <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                     Fill="{Binding ElementName=Root, Path=ResolvedFg}" />
            <TextBlock Text="{Binding ElementName=Root, Path=Label}"
                       FontWeight="SemiBold"
                       Foreground="{Binding ElementName=Root, Path=ResolvedFg}"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
