<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Pulse.WPF</RootNamespace>
    <AssemblyName>Pulse.WPF</AssemblyName>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <ApplicationIcon />
    <Version>0.4.5</Version>
    <AssemblyVersion>0.4.5.0</AssemblyVersion>
    <FileVersion>0.4.5.0</FileVersion>
    <InformationalVersion>0.4.5</InformationalVersion>
    <Authors>PlayOn / Pixellot Field Tools</Authors>
    <Product>Pulse — Pixellot Unified Live System Evaluator (WPF Pilot)</Product>
    <Description>WPF pilot for the Camera Connectivity panel of the Pulse VPU diagnostic tool. Side-by-side with the existing WinForms Pulse.ps1 implementation.</Description>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MaterialDesignThemes" Version="4.9.0" />
    <PackageReference Include="MaterialDesignColors" Version="2.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- WMI: Win32_DiskDrive, Win32_LogicalDisk, Win32_VideoController,
         Win32_OperatingSystem, MSStorageDriver_FailurePredictStatus, etc. -->
    <Reference Include="System.Management" />
    <!-- ServiceController for the Pixellot Services panel -->
    <Reference Include="System.ServiceProcess" />
    <!-- EventLogReader for disk-error scans -->
    <Reference Include="System.Core" />
  </ItemGroup>

</Project>
