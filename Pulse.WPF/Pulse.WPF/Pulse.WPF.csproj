<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Pulse.WPF</RootNamespace>
    <AssemblyName>Pulse.WPF</AssemblyName>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <Version>0.5.6</Version>
    <Authors>PlayOn / Pixellot Field Tools</Authors>
    <Product>Pulse — Pixellot Unified Live System Evaluator</Product>
    <Description>Pulse is the active WPF diagnostic line for the Pixellot VPU — Dashboard, System Overview, Camera Connectivity, Network, Hardware, Disk Health, Services, Event Viewer, and Reports.</Description>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MaterialDesignThemes" Version="4.9.0" />
    <PackageReference Include="MaterialDesignColors" Version="2.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- WMI: Win32_DiskDrive, Win32_LogicalDisk, Win32_VideoController,
         Win32_OperatingSystem, MSStorageDriver_FailurePredictStatus, etc. -->
    <Reference Include="System.Management" />
    <!-- ServiceController for the Pixellot Services panel -->
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>

</Project>
