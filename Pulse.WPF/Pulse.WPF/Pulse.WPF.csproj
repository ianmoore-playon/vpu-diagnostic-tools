<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Pulse.WPF</RootNamespace>
    <AssemblyName>Pulse.WPF</AssemblyName>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <Version>0.8.25-beta</Version>
    <Authors>PlayOn / Pixellot Field Tools</Authors>
    <Product>Pulse — Pixellot Unified Live System Evaluator</Product>
    <Description>Pulse is the active WPF diagnostic line for the Pixellot VPU — Dashboard, System Overview, Camera Connectivity, Network, Score Connect, Disk Health, Services, Event Viewer, and Reports.</Description>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MaterialDesignThemes" Version="4.9.0" />
    <PackageReference Include="MaterialDesignColors" Version="2.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- WMI: Win32_DiskDrive, Win32_LogicalDisk, Win32_VideoController,
         Win32_OperatingSystem, MSStorageDriver_FailurePredictStatus, etc. -->
    <Reference Include="System.Management" />
    <!-- ServiceController for the Pixellot Services panel -->
    <Reference Include="System.ServiceProcess" />
    <!-- v0.6.0 — HttpClient (ScoreConnect III API) + ClientWebSocket (Phase 4
         live data). Both ship in the .NET Framework 4.8 GAC; the explicit
         <Reference> entries make the build deterministic when csproj globs
         are evaluated without the SDK reference assemblies. -->
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Net.WebSockets" />
    <Reference Include="System.Net.WebSockets.Client" />
    <!-- Support bundles are zipped with System.IO.Compression.ZipFile. -->
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <!-- v0.6.1 — System.IO.Ports.SerialPort.GetPortNames() replaces the
         non-existent ScoreConnect III get-available-ports endpoint. On
         .NET Framework 4.8 the SerialPort type ships inside System.dll
         (System.IO.Ports namespace), which the SDK auto-references — no
         extra Reference entry needed. -->
  </ItemGroup>

  <ItemGroup>
    <!-- v0.6.7 — expose the bundled Assets PNGs as WPF Resources so the
         About panel can resolve the icon via the pack:// URI
         "/Pulse.WPF;component/Assets/icon.png". icon.ico stays declared
         separately above as the EXE-level ApplicationIcon. -->
    <Resource Include="Assets\icon.png" />
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\logo-horizontal.png" />
  </ItemGroup>

</Project>
